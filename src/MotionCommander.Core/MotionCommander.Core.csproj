<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <Product>Motion Commander Core</Product>
    <Company>BlackTecCom - Jaborov Daler</Company>
    <Authors>BlackTecCom - Jaborov Daler</Authors>
    <Copyright>Copyright © 2026 BlackTecCom - Jaborov Daler. All rights reserved.</Copyright>
    <Description>High-performance cross-platform data streaming, storage diagnostic, and archive engine for Linux, macOS, and Windows.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/BlackTecCom2000/MotionCommander</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <!-- Windows-specific references only when compiling or running on Windows -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
