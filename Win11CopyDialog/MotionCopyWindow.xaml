<Window x:Class="Win11CopyDialog.MotionCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Win11CopyDialog.Controls"
        Title="Motion Copy Engine" Height="830" Width="670" MinWidth="560" MinHeight="640"
        Background="Transparent" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" CornerRadius="12,12,12,12"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <!-- Root: Liquid Glass Window Shell -->
    <Border x:Name="RootBorder" Style="{StaticResource GlassWindowRoot}"
            RenderTransformOrigin="0.5,0.4" Opacity="0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.965" ScaleY="0.965"/>
        </Border.RenderTransform>
        <DockPanel>

            <!-- ── TITLE BAR ─────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Style="{StaticResource GlassDialogTitleBar}" Height="44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title + PRO badge -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,9,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                  Color="{DynamicResource GlowAccentColor}" Opacity="0.85"/>
                            </Border.Effect>
                            <TextBlock Text="✦" FontSize="13" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Motion Copy Engine" Foreground="{DynamicResource TitleForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource GlassStatusPill}" Padding="7,2" Margin="9,0,0,0">
                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Status pill beacon -->
                    <Border x:Name="StatePill" Grid.Column="1" Style="{StaticResource GlassStatusPill}"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="BeaconDot" Width="7" Height="7"
                                     Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="7" ShadowDepth="0"
                                                      Color="{DynamicResource GlowAccentColor}" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="PillText" Text="Подготовка" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Caption buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="PinBtn" Style="{StaticResource CaptionButton}"
                                Content="◌" ToolTip="Поверх всех окон" Click="Pin_Click" Opacity="0.55"/>
                        <Button Style="{StaticResource CaptionButton}" Content="─" Click="Min_Click"/>
                        <Button Style="{StaticResource CaptionCloseButton}" Content="✕" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── FLOATING CONTROL DOCK ─────────────────────────────── -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource GlassFloatingDock}"
                    Margin="18,0,18,16" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PauseBtn" Style="{StaticResource AccentButton}"
                            MinWidth="130" Height="36" Content="❚❚ Пауза" Click="Pause_Click"/>
                    <Button x:Name="SkipBtn" Style="{StaticResource Win11Button}"
                            Grid.Column="1" Height="36" Margin="8,0,0,0"
                            Content="⏭ Пропустить" Click="Skip_Click"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0,0,0">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                  Color="{DynamicResource GlowAccentColor}" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StateHint" FontSize="11" FontWeight="SemiBold"
                                   Style="{StaticResource MutedText}"
                                   Text="Поток данных активен" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="CloseBtn" Grid.Column="3" Style="{StaticResource Win11Button}"
                            MinWidth="100" Height="36" Content="✕ Отмена" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- ── MAIN SCROLL CONTENT ───────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,16">
                <StackPanel>

                    <!-- HERO VISUALIZER -->
                    <Border Style="{StaticResource GlassSectionCard}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Height="256">
                                <ctrl:TransferVisualizer x:Name="HeroFlow"/>
                                <Grid IsHitTestVisible="False">
                                    <!-- File path chip -->
                                    <Border Style="{StaticResource GlassStatusPill}"
                                            Padding="10,6" VerticalAlignment="Top"
                                            HorizontalAlignment="Left" Margin="4,4,0,0" MaxWidth="380">
                                        <StackPanel>
                                            <StackPanel x:Name="FileBlock" Orientation="Horizontal">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="FileSlide" X="0"/>
                                                </StackPanel.RenderTransform>
                                                <TextBlock Text="📄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="FileNameText" Text="Подготовка…"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock x:Name="RouteText" FontSize="10"
                                                       Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" Margin="20,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Center progress telemetry -->
                                    <StackPanel x:Name="ActiveTelemetry" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <TextBlock x:Name="PercentBig" Text="0%" FontSize="48" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                                  Color="{DynamicResource GlowAccentColor}" Opacity="0.35"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <Border Style="{StaticResource GlassStatusPill}"
                                                Padding="12,4" Margin="0,4,0,0" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <Run x:Name="SpeedBig" Text="0 МБ/с" FontSize="15"
                                                         FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="EtaBig" Text="" FontSize="11"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- Completion hologram -->
                                    <StackPanel x:Name="CheckOverlay" VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Opacity="0" IsHitTestVisible="False" Margin="0,8,0,0">
                                        <Grid Width="60" Height="60" HorizontalAlignment="Center">
                                            <Ellipse Width="60" Height="60" Fill="#107C10">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="22" ShadowDepth="0"
                                                                      Color="#10B981" Opacity="0.9"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Path x:Name="CheckPath"
                                                  Data="M19 30 L27 38 L43 22" Stroke="White"
                                                  StrokeThickness="4.5" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeDashArray="60" StrokeDashOffset="60"/>
                                        </Grid>
                                        <Border Background="#22107C10" BorderBrush="#88107C10"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                                            <TextBlock Text="100% ЗАВЕРШЕНО" FontSize="12"
                                                       FontWeight="Bold" Foreground="#107C10"/>
                                        </Border>
                                        <TextBlock x:Name="CompletionStatsText"
                                                   Text="Все файлы успешно переданы" FontSize="11"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <ctrl:FluidProgressBar x:Name="FluidBar" Margin="0,10,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- BENTO STAT CARDS -->
                    <UniformGrid Columns="5" Margin="0,0,0,12">
                        <Border Style="{StaticResource GlassStatCard}" Margin="0,0,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="📦" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Передано" FontSize="10" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatTransferred" Text="—" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassStatCard}" Margin="4,0,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⏳" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Осталось" FontSize="10" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatRemaining" Text="—" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassStatCard}" Margin="4,0,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="📁" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Файлы" FontSize="10" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatFiles" Text="0 / 0" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassStatCard}" Margin="4,0,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Скорость" FontSize="10" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatSpeed" Text="—" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassStatCard}" Margin="4,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⏱" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Время" FontSize="10" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatEta" Text="—" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- WAVEFORM TELEMETRY -->
                    <Border Style="{StaticResource GlassSectionCard}" Padding="14,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📡" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Живая телеметрия скорости" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <Border Style="{StaticResource GlassStatusPill}"
                                        Padding="7,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="WavePeak" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="пик 0 МБ/с"/>
                                </Border>
                            </DockPanel>
                            <ctrl:WaveformGraph x:Name="WaveGraph" Height="96"/>
                        </StackPanel>
                    </Border>

                    <!-- FILE LIST TOGGLE -->
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="FilesToggle" Style="{StaticResource Win11Button}"
                                HorizontalAlignment="Left" Padding="12,5" Click="FilesToggle_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 Список файлов" FontWeight="SemiBold"
                                           FontSize="12" Margin="0,0,6,0"/>
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="8" Padding="6,1" Margin="0,0,6,0">
                                    <TextBlock x:Name="FilesCountBadge" Text="0" FontSize="10"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="FilesArrow" Text="⌄" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <Border x:Name="FilesCard" Style="{StaticResource GlassSectionCard}"
                            Padding="0" MaxHeight="190" Visibility="Collapsed">
                        <ListView x:Name="FilesList" BorderThickness="0" MaxHeight="188"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="FilesList_DoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding"    Value="8,5"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ListHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="34" DisplayMemberBinding="{Binding StatusGlyph}"/>
                                    <GridViewColumn Header="Имя файла" Width="300" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="Размер" Width="95" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="Прогресс" Width="85"
                                                    DisplayMemberBinding="{Binding Progress, StringFormat='{}{0:0}%'}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
