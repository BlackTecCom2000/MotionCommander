<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="3.0.0.0" name="MotionCommander.App"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Запуск и контроль прав через SuperAdminPrivilegeHelper и runas -->
        <!-- ТРЕБУЕТСЯ АДМИНИСТРАТОР.
         Раньше здесь стоял asInvoker, и Windows никогда не предлагала
         повышение сама: запрос делал код при запуске, а при отказе
         пользователя программа продолжала работу без прав, и данные
         S.M.A.R.T. оказывались недоступны без предупреждения.

         С requireAdministrator запрос повышения делает сама оболочка
         до запуска кода. Если пользователь откажется, процесс не
         стартует вовсе — это честнее, чем показывать половину пустых
         показателей. -->
    <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
