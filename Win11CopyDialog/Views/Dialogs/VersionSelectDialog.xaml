<Window x:Class="Win11CopyDialog.Views.Dialogs.VersionSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор версии — Motion Commander"
        Width="880" Height="600" MinWidth="740" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <!-- Корневой контейнер Liquid Glass -->
    <Border x:Name="RootBorder" Style="{StaticResource GlassWindowRoot}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Шапка -->
                <RowDefinition Height="*"/>    <!-- Рабочая область: список версий + детали -->
                <RowDefinition Height="Auto"/> <!-- Всегда видимый нижний бар действий -->
            </Grid.RowDefinitions>

            <!-- 1. ШАПКА ОКНА (Перетаскивание) -->
            <Border Grid.Row="0" Style="{StaticResource GlassDialogTitleBar}" Padding="18,12" MouseDown="Header_MouseDown">
                <DockPanel LastChildFill="True">
                    <!-- Кнопка закрытия -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}" Content="✕" Click="Close_Click" VerticalAlignment="Center"/>

                    <!-- Иконка и заголовки -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LiquidGlassActiveHighlight}"
                                BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ВЫБОР ВЕРСИИ И ОТКАТ" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="{DynamicResource LiquidGlassActiveHighlight}" BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Time Machine &amp; Rollback" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="CurrentVersionSubtext" Text="Текущая версия: v3.8.13 | Выберите любую версию для обновления или безопасного отката назад"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. ОСНОВНАЯ ОБЛАСТЬ (СПИСОК ВЕРСИЙ + ДЕТАЛИ) -->
            <Grid Grid.Row="1" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="220" MaxWidth="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Список доступных версий -->
                <Border Grid.Column="0" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                        BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Поиск / Фильтр и статус загрузки -->
                        <DockPanel Grid.Row="0" Margin="4,4,4,8">
                            <Button x:Name="RefreshReleasesBtn" DockPanel.Dock="Right" Style="{StaticResource GlassButton}"
                                    Content="⟳" Width="28" Height="28" Padding="0" ToolTip="Обновить список релизов из GitHub"
                                    Click="RefreshReleasesBtn_Click"/>
                            <TextBlock Text="История релизов" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Индикатор загрузки списка версий -->
                        <StackPanel x:Name="LoadingPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="100" Height="4" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Загрузка релизов..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Сам список версий -->
                        <ListBox x:Name="ReleasesListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ReleasesListBox_SelectionChanged"
                                 Visibility="Collapsed">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" CornerRadius="8" Padding="10,8" Background="Transparent"
                                                        BorderBrush="Transparent" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LiquidGlassHoverHighlight}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource LiquidGlassInputBorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource DialogChromaticBevel}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <!-- Бейдж статуса (Текущая / Обновление / Откат) -->
                                        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                                Background="{DynamicResource ChipBackgroundBrush}">
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="9.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="#00F0FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUpgrade}" Value="True">
                                                                <Setter Property="Foreground" Value="#70A0FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDowngrade}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFA040"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Иконка и версия -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ReleaseDate}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Вертикальный разделитель Liquid Glass -->
                <Separator Grid.Column="1" Style="{StaticResource LiquidGlassDividerVertical}" Height="Auto" Margin="10,0"/>

                <!-- Правая колонка: Детали выбранной версии и чейнджлог -->
                <Border Grid.Column="2" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                        BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Инфо о версии -->
                            <RowDefinition Height="Auto"/> <!-- Предупреждение об откате (если откат) -->
                            <RowDefinition Height="*"/>    <!-- Список изменений -->
                        </Grid.RowDefinitions>

                        <!-- Шапка деталей -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <Border x:Name="SelectedStatusBadge" DockPanel.Dock="Right" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                                    Background="{DynamicResource LiquidGlassActiveHighlight}" BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1">
                                <TextBlock x:Name="SelectedStatusBadgeText" Text="Релиз готов к установке" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedVersionTitle" Text="Выберите версию из списка слева" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="SelectedVersionDate" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Блок предупреждения при откате (Downgrade warning) -->
                        <Border x:Name="RollbackWarningCard" Grid.Row="1" Background="#26FFA040" BorderBrush="#80FFA040" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Режим отката назад (Rollback): Будет загружена более старая сборка. Новые функции и последние исправления текущей версии станут недоступны."
                                           FontSize="11" Foreground="#FFE090" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Список изменений (Changelog) -->
                        <Border Grid.Row="2" Background="{DynamicResource LiquidGlassInputBackgroundBrush}"
                                BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBox x:Name="ChangelogTextBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5"
                                         TextWrapping="Wrap" IsReadOnly="True" AcceptsReturn="True"
                                         Text="Загрузка списка изменений..."/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. ВСЕГДА ВИДИМЫЙ НИЖНИЙ БАР ДЕЙСТВИЙ (STICKY BOTTOM BAR) -->
            <Border Grid.Row="2" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                    BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource GlassButton}" Content="Отмена" MinWidth="90" Height="36" Margin="0,0,10,0" Click="Close_Click"/>
                        <Button x:Name="ApplyVersionBtn" Style="{StaticResource GlassPrimaryButton}"
                                Content="🚀 Применить выбранную версию" MinWidth="220" Height="36"
                                Click="ApplyVersionBtn_Click" IsEnabled="False"/>
                    </StackPanel>

                    <!-- Статусная строка внизу слева -->
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BottomStatusText" Text="Готово к переключению версий"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
