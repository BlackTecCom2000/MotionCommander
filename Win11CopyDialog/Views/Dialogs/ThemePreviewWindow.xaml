<Window x:Class="Win11CopyDialog.Views.Dialogs.ThemePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Preview: Motion Glass (Dark vs Light)" Height="420" Width="880" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Left: Motion Glass (Dark) -->
        <StackPanel x:Name="LeftPanel" Margin="6">
            <TextBlock Text="Motion Glass (Dark)" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" x:Name="LeftTitle"/>
            <Border x:Name="LeftCard" Height="110" CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Margin="0,0,0,6"/>
            <TextBlock Text="Sample text on card" x:Name="LeftSampleText" Margin="6,4,0,0"/>
            <Button Content="Demo Action" Margin="6,8,0,0" x:Name="LeftBtn" />
        </StackPanel>
        <!-- Right: Motion Glass Light -->
        <StackPanel Grid.Column="1" x:Name="RightPanel" Margin="6">
            <TextBlock Text="Motion Glass Light" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" x:Name="RightTitle"/>
            <Border x:Name="RightCard" Height="110" CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Margin="0,0,0,6"/>
            <TextBlock Text="Sample text on card" x:Name="RightSampleText" Margin="6,4,0,0"/>
            <Button Content="Demo Action" Margin="6,8,0,0" x:Name="RightBtn" />
        </StackPanel>
    </Grid>
</Window>