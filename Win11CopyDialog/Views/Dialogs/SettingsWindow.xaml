<Window x:Class="Win11CopyDialog.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры и настройка — Motion Commander"
        Height="700" Width="940" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <!-- Корневой контейнер Liquid Glass -->
    <Border Style="{StaticResource GlassWindowRoot}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Шапка окна -->
                <RowDefinition Height="*"/>    <!-- 1: Вкладки настроек со ScrollViewer -->
                <RowDefinition Height="Auto"/> <!-- 2: Закрепленная нижняя панель действий -->
            </Grid.RowDefinitions>

            <!-- 1. ШАПКА ОКНА (Перетаскивание и управление) -->
            <Border Grid.Row="0" Style="{StaticResource GlassDialogTitleBar}" Padding="18,12" MouseDown="Header_MouseDown">
                <DockPanel LastChildFill="True">
                    <!-- Кнопки управления окном -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionButton}" Content="─" ToolTip="Свернуть" Click="Min_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource CaptionCloseButton}" Content="✕" ToolTip="Закрыть" Click="Close_Click"/>
                    </StackPanel>

                    <!-- Иконка и заголовки -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LiquidGlassActiveHighlight}"
                                BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ПАРАМЕТРЫ И НАСТРОЙКИ" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="{DynamicResource LiquidGlassActiveHighlight}" BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderVersionBadgeText" Text="v3.8.46" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Персонализация интерфейса, интеграция с Windows, параметры I/O и конфигурация"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. ВКЛАДКИ НАСТРОЕК -->
            <TabControl Grid.Row="1" Style="{StaticResource GlassTabControl}" Margin="16,6,16,6">

                <!-- ВКЛАДКА 1: ТЕМЫ И ВИЗУАЛИЗАЦИЯ -->
                <TabItem Header="🎨 Темы и визуализация" FontSize="12">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,6,10,14">
                        <StackPanel>
                            <!-- Выбор темы оформления -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Тема оформления интерфейса" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Дизайнерские стили, оптимизированные для глубокого контраста, OLED-дисплеев и эффектов стекла" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ThemesComboBox" FontSize="12" Padding="10,6" SelectionChanged="ThemesComboBox_SelectionChanged"/>
                                        <Border Grid.Column="1" Margin="14,0,0,0" Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="6" Padding="12,8">
                                            <TextBlock x:Name="ThemeDescriptionText" Text="Описание темы..." FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Выбор акцентного цвета -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Цветовой акцент и неоновое свечение" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Определяет цвет выделения элементов, графиков скорости передачи данных и индикаторов" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <WrapPanel x:Name="AccentsWrapPanel" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>

                            <!-- Материал окна Windows 11 DWM -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Системный материал окна (Windows 11 DWM)" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Аппаратное полупрозрачное размытие рабочего стола под окнами Motion Commander" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton x:Name="BackdropMicaRadio" Content="◈ Mica Alt (Премиальный матовый)" IsChecked="True" Margin="0,0,18,8" Checked="BackdropRadio_Checked"/>
                                        <RadioButton x:Name="BackdropAcrylicRadio" Content="⬣ Fluent Acrylic (Глубокое размытие)" Margin="0,0,18,8" Checked="BackdropRadio_Checked"/>
                                        <RadioButton x:Name="BackdropSolidRadio" Content="⬛ Сплошной непрозрачный фон" Margin="0,0,18,8" Checked="BackdropRadio_Checked"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Интенсивность фона и живой фон -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Интенсивность фона и эффекты свечения" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Регулирует яркость звёздного фона, туманностей и световых аур за окнами для максимальной читаемости текста" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BackdropIntensitySlider" Style="{StaticResource GlassSlider}"
                                                Minimum="0" Maximum="100" Value="65" SmallChange="5" LargeChange="10"
                                                VerticalAlignment="Center" ValueChanged="BackdropIntensitySlider_ValueChanged"/>
                                        <Border Grid.Column="1" Margin="14,0,0,0" Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="6" Padding="12,5" MinWidth="75">
                                            <TextBlock x:Name="BackdropIntensityText" Text="65%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <CheckBox x:Name="LiveBackdropCheck"
                                              Content="🌌 Живой анимированный фон (звёзды, планеты, туманности)"
                                              Margin="0,6,0,0"
                                              IsChecked="True"
                                              Checked="LiveBackdrop_Changed"
                                              Unchecked="LiveBackdrop_Changed"/>
                                    <TextBlock x:Name="LiveBackdropHint" Text="🌌 Живой фон включён — звёзды и туманности анимируются"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,3,0,10"/>

                                    <CheckBox x:Name="SmoothScrollCheck"
                                              Content="📜 Плавная кинетическая прокрутка списков (Smooth Kinetic Scroll)"
                                              Margin="0,0,0,0"
                                              IsChecked="True"
                                              Checked="SmoothScrollCheck_Changed"
                                              Unchecked="SmoothScrollCheck_Changed"/>
                                    <TextBlock Text="Мягкое сглаживание колеса мыши и инерция прокрутки файлов без рывков"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Качество анимаций и энергопотребление -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Качество анимаций и энергосбережение" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Управляет частотой кадров и энергопотреблением при работе от батареи или на слабых ПК" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="AnimationEconomyRadio" Content="⚡ Эконом (30 FPS, статичный фон, энергосбережение)" Margin="0,0,20,0" Checked="AnimationQuality_Checked"/>
                                        <RadioButton x:Name="AnimationMaximumRadio" Content="✨ Высокая плавность (60 FPS, живой фон)" IsChecked="True" Checked="AnimationQuality_Checked"/>
                                    </StackPanel>

                                    <TextBlock x:Name="AnimationPerfText" Text=""
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Режим установки и папка данных -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Режим установки и хранения данных" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="В портативном режиме настройки и кэши сохраняются рядом с программой — идеально для переносных накопителей" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="InstallModeInstalledRadio" Content="📁 Полная установка" Margin="0,0,18,0" Checked="InstallMode_Checked"/>
                                        <RadioButton x:Name="InstallModePortableRadio" Content="💾 Портативный режим" Margin="0,0,18,0" Checked="InstallMode_Checked"/>
                                        <RadioButton x:Name="InstallModeAutoRadio" Content="🔄 Автоопределение" IsChecked="True" Checked="InstallMode_Checked"/>
                                    </StackPanel>

                                    <TextBlock x:Name="InstallModeDetailText" Text=""
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                    <Button x:Name="OpenDataFolderBtn" Style="{StaticResource GlassButton}" Content="📂 Открыть папку данных приложения"
                                            HorizontalAlignment="Left" Padding="12,6" FontSize="11" Click="OpenDataFolder_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ВКЛАДКА 2: ИНТЕГРАЦИЯ WINDOWS -->
                <TabItem Header="🔗 Интеграция Windows" FontSize="12">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,6,10,14">
                        <StackPanel>
                            <!-- Замена стандартного Проводника -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border x:Name="ExplorerStatusBadge" DockPanel.Dock="Right" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource ChipBackgroundBrush}">
                                            <TextBlock x:Name="ExplorerStatusBadgeText" Text="Стандартный Windows Explorer" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Замена стандартного Проводника Windows" FontWeight="Bold" FontSize="13" Margin="0,0,0,2"/>
                                            <TextBlock Text="Открывать Motion Commander при переходе в любые папки и логические диски" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Text="Перенаправляет системные вызовы открытия папок и локальных дисков в Motion Commander вместо медленного Windows Explorer. Панель задач, меню «Пуск» и рабочий стол остаются полностью стабильными и продолжают работать штатно." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <WrapPanel>
                                        <Button x:Name="ToggleExplorerBtn" Style="{StaticResource GlassPrimaryButton}" Content="⚡ Назначить проводником по умолчанию" Padding="14,7" Margin="0,0,10,6" Click="ToggleExplorerReplacement_Click"/>
                                        <Button x:Name="RestoreExplorerBtn" Style="{StaticResource GlassButton}" Content="↺ Вернуть стандартный Проводник Windows" Padding="14,7" Margin="0,0,0,6" Click="RestoreExplorer_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Контекстное меню Windows -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border x:Name="ContextMenuStatusBadge" DockPanel.Dock="Right" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource ChipBackgroundBrush}">
                                            <TextBlock x:Name="ContextMenuStatusBadgeText" Text="Не интегрировано" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Пункты контекстного меню Windows" FontWeight="Bold" FontSize="13" Margin="0,0,0,2"/>
                                            <TextBlock Text="Быстрый доступ к открытию и архивации через правый клик мыши" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Text="Добавляет быстрые команды «Открыть в Motion Commander» и «Сжать в архив...» в контекстное меню файлов, папок и фона директорий Windows для мгновенного доступа." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <WrapPanel>
                                        <Button x:Name="ToggleContextMenuBtn" Style="{StaticResource GlassPrimaryButton}" Content="➕ Добавить пункты в контекстное меню" Padding="14,7" Margin="0,0,10,6" Click="ToggleContextMenu_Click"/>
                                        <Button x:Name="RemoveContextMenuBtn" Style="{StaticResource GlassButton}" Content="🗑 Удалить из контекстного меню" Padding="14,7" Margin="0,0,0,6" Click="RemoveContextMenu_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ВКЛАДКА 3: ЗВУК И HAPTICS -->
                <TabItem Header="🔊 Звук и Haptics" FontSize="12">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,6,10,14">
                        <StackPanel>
                            <!-- Общий переключатель синтезатора -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="HapticsEnabledCheckBox" Content="Включить процедурный звуковой отклик (Haptic Audio Synth)" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" Checked="HapticsCheckBox_Changed" Unchecked="HapticsCheckBox_Changed"/>
                                    <TextBlock Text="Синтезирует акустические микроимпульсы в реальном времени напрямую в памяти (WAV RAM) без внешних аудиофайлов и задержек" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>

                            <!-- Отдельные переключатели эффектов -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Настройка отдельных эффектов" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Выберите, для каких именно действий в интерфейсе воспроизводить звуковой отклик:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox x:Name="ClickSoundsCheck" Grid.Row="0" Grid.Column="0" Content="🔘 Звуки кликов и навигации" Margin="0,0,10,10" IsChecked="True" Checked="SoundSubToggle_Changed" Unchecked="SoundSubToggle_Changed"/>
                                        <CheckBox x:Name="HoverSoundsCheck" Grid.Row="0" Grid.Column="1" Content="✨ Звуки наведения курсора" Margin="0,0,0,10" IsChecked="True" Checked="SoundSubToggle_Changed" Unchecked="SoundSubToggle_Changed"/>
                                        <CheckBox x:Name="ScrollSoundsCheck" Grid.Row="1" Grid.Column="0" Content="📜 Тактильный щелчок при скролле" Margin="0,0,10,6" IsChecked="True" Checked="SoundSubToggle_Changed" Unchecked="SoundSubToggle_Changed"/>
                                        <CheckBox x:Name="SuccessSoundsCheck" Grid.Row="1" Grid.Column="1" Content="🎵 Мелодия завершения операций" Margin="0,0,0,6" IsChecked="True" Checked="SoundSubToggle_Changed" Unchecked="SoundSubToggle_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Тестирование звуков -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Тестирование звуковых импульсов:" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Нажмите на кнопку для мгновенной проверки отклика генератора частот" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <WrapPanel>
                                        <Button Style="{StaticResource GlassButton}" Content="🔘 Тест клика" Margin="0,0,8,8" Padding="14,6" Click="TestClick_Click"/>
                                        <Button Style="{StaticResource GlassButton}" Content="✨ Тест наведения" Margin="0,0,8,8" Padding="14,6" Click="TestHover_Click"/>
                                        <Button Style="{StaticResource GlassButton}" Content="📜 Тик скролла" Margin="0,0,8,8" Padding="14,6" Click="TestScroll_Click"/>
                                        <Button Style="{StaticResource GlassButton}" Content="🎵 Звук успеха" Margin="0,0,8,8" Padding="14,6" Click="TestSuccess_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ВКЛАДКА 4: ПАРАМЕТРЫ I/O -->
                <TabItem Header="⚡ Параметры I/O" FontSize="12">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,6,10,14">
                        <StackPanel>
                            <!-- Оптимизация копирования -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Оптимизация высокоскоростного копирования" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Тонкая настройка системных вызовов CreateFileW, кольцевых буферов I/O и прямого доступа к диску" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Размер I/O буфера:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        <ComboBox x:Name="DefaultBufferCombo" SelectionChanged="IoSetting_Changed" Grid.Column="1" Width="260" HorizontalAlignment="Left" SelectedIndex="2">
                                            <ComboBoxItem Content="256 КБ (Для USB 2.0 / HDD)"/>
                                            <ComboBoxItem Content="512 КБ (Сбалансированный)"/>
                                            <ComboBoxItem Content="1 МБ (Рекомендуется для NVMe)"/>
                                            <ComboBoxItem Content="2 МБ (Высокая скорость SSD)"/>
                                            <ComboBoxItem Content="4 МБ (Максимальный поток)"/>
                                            <ComboBoxItem Content="8 МБ (Экстремальный RAM)"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Параллельные потоки:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        <ComboBox x:Name="ThreadsCombo" SelectionChanged="IoSetting_Changed" Grid.Column="1" Width="260" HorizontalAlignment="Left" SelectedIndex="2">
                                            <ComboBoxItem Content="1 поток (Строго последовательно)"/>
                                            <ComboBoxItem Content="2 потока"/>
                                            <ComboBoxItem Content="4 потока (Оптимально)"/>
                                            <ComboBoxItem Content="8 потоков (Для SSD массивов)"/>
                                            <ComboBoxItem Content="16 потоков (Максимум I/O)"/>
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox x:Name="DirectIoCheck" Checked="IoSetting_Changed" Unchecked="IoSetting_Changed" Content="Обход файлового кэша Windows (Direct I/O / FILE_FLAG_NO_BUFFERING)" Margin="0,4,0,8" IsChecked="False"/>
                                    <CheckBox x:Name="SequentialScanCheck" Checked="IoSetting_Changed" Unchecked="IoSetting_Changed" Content="Подсказка планировщику ядра Windows (FILE_FLAG_SEQUENTIAL_SCAN)" Margin="0,0,0,8" IsChecked="True"/>
                                    <CheckBox x:Name="VerifyCrcCheck" Checked="IoSetting_Changed" Unchecked="IoSetting_Changed" Content="Автоматический расчёт CRC-32 контрольной суммы на лету" Margin="0,0,0,8" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <!-- Действующие параметры -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Фактически применяемые параметры копирования:" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="8" Padding="14,10">
                                        <TextBlock x:Name="IoSettingsSummaryText" Text="" FontSize="11.5" LineHeight="18" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ВКЛАДКА 5: РЕДАКТОР КОНФИГУРАЦИИ -->
                <TabItem Header="📝 Редактор конфигурации" FontSize="12">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Инструменты -->
                            <RowDefinition Height="*"/>    <!-- Редактор текста -->
                            <RowDefinition Height="Auto"/> <!-- Нижние кнопки -->
                        </Grid.RowDefinitions>

                        <!-- Панель инструментов редактора -->
                        <Border Grid.Row="0" Style="{StaticResource LiquidGlassCard}" Padding="12" Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Style="{StaticResource GlassButton}" Content="🔍 Проверить синтаксис" Padding="10,4" Margin="0,0,6,0" Click="ValidateSyntax_Click"/>
                                    <Button Style="{StaticResource GlassButton}" Content="↺ Отменить правки" Padding="10,4" Margin="0,0,6,0" Click="RevertConfig_Click" ToolTip="Вернуть текст из сохранённого файла"/>
                                    <Button Style="{StaticResource GlassButton}" Content="📂 Папка конфига" Padding="10,4" Click="OpenConfigFolder_Click"/>
                                </StackPanel>
                                <TextBlock Text="Прямой просмотр и правка конфигурационного файла settings.json:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5"/>
                            </DockPanel>
                        </Border>

                        <!-- Текстовое поле с индикатором ошибок -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Баннер ошибки синтаксиса -->
                            <Border x:Name="ConfigErrorBanner" Grid.Row="0" Visibility="Collapsed" CornerRadius="8"
                                    Background="#33FF4567" BorderBrush="#FF4567" BorderThickness="1"
                                    Padding="12,8" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ConfigErrorText" Text="Ошибка JSON" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource LiquidGlassCard}" Padding="6">
                                <TextBox x:Name="ConfigEditorBox" Background="{DynamicResource LiquidGlassInputBackgroundBrush}" BorderThickness="0"
                                         Foreground="#00F0FF" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                                         AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         TextChanged="ConfigEditorBox_TextChanged"/>
                            </Border>
                        </Grid>

                        <!-- Нижняя панель действий редактора -->
                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <Button Style="{StaticResource GlassButton}" Content="🔄 Перечитать с диска" DockPanel.Dock="Left" Padding="12,6" Click="ReloadConfig_Click"/>
                            <Button Style="{StaticResource GlassButton}" Content="↺ Сбросить до заводских" DockPanel.Dock="Left" Margin="8,0,0,0" Padding="12,6" Click="ResetConfig_Click"/>
                            <Button Style="{StaticResource GlassPrimaryButton}" Content="💾 Сохранить и применить" HorizontalAlignment="Right" Padding="18,6" Click="SaveConfig_Click"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ВКЛАДКА 6: ЛИЦЕНЗИЯ И ДОНАТ -->
                <TabItem Header="⭐ Лицензия и донат" FontSize="12">
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,6,10,14">
                        <StackPanel>
                            <!-- Управление версиями и откат (Time Machine) -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Background="{DynamicResource ChipBackgroundBrush}">
                                            <TextBlock x:Name="SettingsCurrentVersionText" Text="v3.8.46" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Управление версиями и откат (Time Machine)" FontWeight="Bold" FontSize="13" Margin="0,0,0,2"/>
                                            <TextBlock Text="Переключение на любую прошлую или новую версию программы" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Text="Позволяет выбрать любую версию Motion Commander из истории релизов и загрузить выбранную версию или безопасно откатиться назад без потери настроек. Загрузка идёт с официального адреса проекта, целостность архива проверяется по SHA-256 до применения."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <Button Style="{StaticResource GlassPrimaryButton}" Content="⏳ Выбрать версию программы (Обновить или откатить назад)" HorizontalAlignment="Left" Padding="16,7" Click="OpenVersionSelector_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Лицензия продукта -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Лицензия продукта" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LicenseVersionText" Text="Motion Commander Pro — Зарегистрировано на:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="BlackTecCom - Jaborov Daler (Full Commercial Lifetime)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Продукт имеет неограниченный доступ ко всем передовым модулям I/O передачи данных, диагностике оборудования и анализу файловой системы." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Донат разработчику -->
                            <Border Style="{StaticResource LiquidGlassCard}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="💳 Поддержать разработчика (Прямой перевод)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Прямой перевод на банковскую карту разработчика без посредников и комиссий сервисов:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button Style="{StaticResource GlassButton}" Content="📋 Копировать" DockPanel.Dock="Right" Padding="12,5" Click="CopyDonation_Click" Tag="alif"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🇹🇯 Alif Bank VISA (Валютная карта):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="•••• •••• •••• 6013" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" ToolTip="Полный номер хранится локально и не входит в публичную сборку."/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="8" Padding="12">
                                        <DockPanel>
                                            <Button Style="{StaticResource GlassButton}" Content="📋 Копировать" DockPanel.Dock="Right" Padding="12,5" Click="CopyDonation_Click" Tag="dc"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🇹🇯 DC Bank VISA (Международные переводы):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="•••• •••• •••• 1431" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" ToolTip="Полный номер хранится локально и не входит в публичную сборку."/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- 3. ЗАКРЕПЛЁННАЯ НИЖНЯЯ ПАНЕЛЬ ДЕЙСТВИЙ (ВСЕГДА ВИДНА И НЕ ПЕРЕКРЫВАЕТ КОНТЕНТ) -->
            <Border Grid.Row="2" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                    BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GlassButton}" Content="↺ Сбросить всё" MinWidth="130" Height="34" Margin="0,0,10,0" Click="ResetAllSettings_Click" ToolTip="Сбросить все параметры к значениям по умолчанию"/>
                        <Button Style="{StaticResource GlassPrimaryButton}" Content="Готово" MinWidth="100" Height="34" Click="Close_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusMessage" Text="Параметры применяются автоматически в реальном времени."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
