<Window x:Class="Win11CopyDialog.Views.Dialogs.WizTreeAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WizTree Анализатор дискового пространства — Motion Commander"
        Height="720" Width="1050" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource GlassWindowRoot}">
        <DockPanel>
            <!-- Шапка -->
            <Border DockPanel.Dock="Top" Style="{StaticResource GlassDialogTitleBar}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LiquidGlassActiveHighlight}"
                                BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🌳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WizTree Анализатор дискового пространства" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Мгновенное сканирование занятого места, визуальная карта веса папок и выявление тяжелых файлов" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource CaptionCloseButton}" Content="✕" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Статус-бар -->
            <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <ProgressBar x:Name="ScanProgressBar" DockPanel.Dock="Right" Width="180" Height="6" IsIndeterminate="True" Visibility="Collapsed" BorderThickness="0" Background="{DynamicResource LiquidGlassInputBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Готово к сканированию. Выберите диск или каталог." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DockPanel>
            </Border>

            <!-- ТЕЛО -->
            <Grid Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель выбора пути и сканирования -->
                <Border Grid.Row="0" Style="{StaticResource GlassSectionCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Путь сканирования:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                        <TextBox x:Name="TargetFolderBox" Grid.Column="1" Style="{StaticResource GlassTextBox}"
                                 Padding="8,4" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource Win11Button}" Content="📂 Обзор..." Margin="8,0,0,0" Padding="12,5" Click="BrowseFolder_Click"/>
                        <Button x:Name="ScanBtn" Grid.Column="3" Style="{StaticResource AccentButton}" Content="⚡ Начать сканирование" Margin="8,0,0,0" Padding="16,5" Click="StartScan_Click"/>
                    </Grid>
                </Border>

                <!-- Основной контент: Вкладки Дерево / Топ-100 / Типы -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <!-- Вкладка 1: Дерево каталогов -->
                    <TabItem Header="📁 Дерево папок и файлов">
                        <Border Style="{StaticResource GlassSectionCard}" Margin="0,8,0,0" Padding="8">
                            <TreeView x:Name="FoldersTreeView" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="340"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding PercentOfParent}" BorderThickness="0" Background="{DynamicResource LiquidGlassInputBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                    </TabItem>

                    <!-- Вкладка 2: Топ-100 самых тяжелых файлов -->
                    <TabItem Header="🏆 Топ тяжелых файлов">
                        <Border Style="{StaticResource GlassSectionCard}" Margin="0,8,0,0" Padding="4">
                            <ListView x:Name="TopFilesList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Открыть папку с файлом" Click="TopFiles_OpenFolder_Click"/>
                                        <MenuItem Header="Удалить файл" Click="TopFiles_Delete_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Имя файла" Width="360">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Размер" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Тип / Расширение" Width="100" DisplayMemberBinding="{Binding Extension}"/>
                                        <GridViewColumn Header="Полный путь" Width="400" DisplayMemberBinding="{Binding FullPath}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </TabItem>

                    <!-- Вкладка 3: Распределение по расширениям -->
                    <TabItem Header="📊 Расширения файлов">
                        <Border Style="{StaticResource GlassSectionCard}" Margin="0,8,0,0" Padding="4">
                            <ListView x:Name="ExtensionsList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Расширение" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Extension}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Суммарный размер" Width="160" DisplayMemberBinding="{Binding FormattedSize}"/>
                                        <GridViewColumn Header="Количество файлов" Width="140" DisplayMemberBinding="{Binding FileCount}"/>
                                        <GridViewColumn Header="Доля от общего веса" Width="200">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ProgressBar Width="120" Height="6" Minimum="0" Maximum="100" Value="{Binding Percent}" BorderThickness="0" Background="{DynamicResource LiquidGlassInputBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding PercentText}" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>
    </Border>
</Window>
