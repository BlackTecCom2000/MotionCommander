<Window x:Class="Win11CopyDialog.Views.Dialogs.CreateArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Win11CopyDialog.Controls"
        Title="Создание архива — Motion Commander"
        Width="600" Height="660" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Style="{StaticResource GlassWindowRoot}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Шапка -->
                <RowDefinition Height="*"/>    <!-- 1: Прокручиваемое содержимое -->
                <RowDefinition Height="Auto"/> <!-- 2: Всегда видимый нижний бар действий -->
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Border Grid.Row="0" Style="{StaticResource GlassDialogTitleBar}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource LiquidGlassActiveHighlight}"
                                BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🗜" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Создание архива" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Сжатие файлов с контролем коэффициента и шифрованием" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource CaptionCloseButton}" Content="✕" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- ОСНОВНОЕ ТЕЛО С ПРОКРУТКОЙ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
                <StackPanel>
                    <!-- Имя и путь архива -->
                    <Border Style="{StaticResource GlassSectionCard}">
                        <StackPanel>
                            <TextBlock Text="Имя и путь к архиву" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Обзор…" Margin="6,0,0,0" Padding="12,4" Click="Browse_Click"/>
                                <TextBox x:Name="ArchivePathBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                         Style="{StaticResource GlassTextBox}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Формат и Сжатие -->
                    <Border Style="{StaticResource GlassSectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Формат архива" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="FormatCombo" Height="32" SelectedIndex="0">
                                        <ComboBoxItem Content=".ZIP (Универсальный)"/>
                                        <ComboBoxItem Content=".7Z (Максимальное сжатие)"/>
                                        <ComboBoxItem Content=".TAR (Без сжатия)"/>
                                        <ComboBoxItem Content=".TAR.GZ (Linux стандарт)"/>
                                        <ComboBoxItem Content=".TAR.BZ2 (Высокое сжатие)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Метод компрессии" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="LevelCombo" Height="32" SelectedIndex="2">
                                        <ComboBoxItem Content="Без сжатия (Store)"/>
                                        <ComboBoxItem Content="Быстрое (Fast)"/>
                                        <ComboBoxItem Content="Оптимальное (Balanced)"/>
                                        <ComboBoxItem Content="Максимальное (Maximum)"/>
                                        <ComboBoxItem Content="Ультра (Ultra)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Слайдер уровня сжатия -->
                            <TextBlock Text="Уровень сжатия (Скорость ↔ Плотность)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Slider x:Name="LevelSlider" Minimum="0" Maximum="4" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="LevelSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Безопасность / Пароль -->
                    <Border Style="{StaticResource GlassSectionCard}">
                        <StackPanel>
                            <TextBlock Text="Шифрование и Защита паролем" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordInput" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                             Style="{StaticResource GlassPasswordBox}"/>
                                <CheckBox x:Name="EncryptHeadersCheck" Grid.Column="1" Content="Шифровать имена файлов (7Z)"
                                          VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="True"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ВИЗУАЛИЗАТОР СЖАТИЯ (Появляется при процессе) -->
                    <Border x:Name="VisualCard" Style="{StaticResource GlassSectionCard}" Visibility="Collapsed">
                        <StackPanel>
                            <ctrl:CompressionVisualizer x:Name="CompVis" Height="140"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CompFileText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CompRatioText" Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                            <ProgressBar x:Name="CompProgress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ПРИКРЕПЛЕННЫЙ НИЖНИЙ БАР ДЕЙСТВИЙ (ВСЕГДА ВИДЕН И НЕ ОБРЕЗАЕТСЯ) -->
            <Border Grid.Row="2" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                    BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <Button x:Name="CancelBtn" Grid.Column="1" Style="{StaticResource GlassButton}" Content="Отмена" MinWidth="95" Height="36" Margin="0,0,10,0" Click="Close_Click"/>
                    <Button x:Name="StartBtn" Grid.Column="2" Style="{StaticResource GlassPrimaryButton}" Content="⚡ Сжать архив" MinWidth="140" Height="36" Click="StartCompress_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
