<Window x:Class="Win11CopyDialog.Views.Dialogs.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление Motion Commander"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource GlassWindowRoot}">
        <DockPanel>
            <!-- ШАПКА -->
            <Border DockPanel.Dock="Top" Style="{StaticResource GlassDialogTitleBar}" Padding="16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource LiquidGlassActiveHighlight}"
                            BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,8,0">
                        <TextBlock Text="🚀" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="Загрузка обновления..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- КНОПКИ -->
            <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Style="{StaticResource Win11Button}" Content="Отмена" MinWidth="80" Height="32" Click="CancelBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- ТЕЛО -->
            <StackPanel VerticalAlignment="Center" Margin="22,12">
                <TextBlock x:Name="StatusText" Text="Скачивание новой версии..." FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Background="{DynamicResource LiquidGlassInputBackgroundBrush}"/>
                <Grid Margin="0,4,0,0">
                    <TextBlock x:Name="PercentText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
