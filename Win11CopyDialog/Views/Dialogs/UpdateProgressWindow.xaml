<Window x:Class="Win11CopyDialog.Views.Dialogs.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление Motion Commander"
        Width="440" Height="230" MinWidth="380" MinHeight="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource GlassWindowRoot}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Шапка -->
                <RowDefinition Height="*"/>    <!-- 1: Прогресс -->
                <RowDefinition Height="Auto"/> <!-- 2: Нижний бар -->
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Border Grid.Row="0" Style="{StaticResource GlassDialogTitleBar}" Padding="18,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource LiquidGlassActiveHighlight}"
                            BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="🚀" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="Загрузка обновления..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ТЕЛО -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="22,14">
                <TextBlock x:Name="StatusText" Text="Скачивание новой версии..." FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Background="{DynamicResource LiquidGlassInputBackgroundBrush}"/>
                <Grid Margin="0,6,0,0">
                    <TextBlock x:Name="PercentText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- КНОПКИ (ПРИКРЕПЛЕННЫЙ НИЖНИЙ БАР) -->
            <Border Grid.Row="2" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                    BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Style="{StaticResource GlassButton}" Content="Отмена" MinWidth="90" Height="34" Click="CancelBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
