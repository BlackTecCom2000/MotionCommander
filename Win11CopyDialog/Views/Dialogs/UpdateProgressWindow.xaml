<Window x:Class="Win11CopyDialog.Views.Dialogs.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление Motion Commander"
        Width="500" Height="290" MinWidth="440" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource GlassWindowRoot}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Шапка -->
                <RowDefinition Height="*"/>    <!-- 1: Прогресс и информация -->
                <RowDefinition Height="Auto"/> <!-- 2: Нижний бар -->
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Border Grid.Row="0" Style="{StaticResource GlassDialogTitleBar}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource LiquidGlassActiveHighlight}"
                                BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🚀" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText" Text="Загрузка обновления..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="─" ToolTip="Свернуть" Click="Min_Click"/>
                        <Button Style="{StaticResource CaptionCloseButton}" Content="✕" ToolTip="Отмена" Click="CancelBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ТЕЛО -->
            <Grid Grid.Row="1" Margin="22,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Метаданные пакета: версии и тип -->
                    <RowDefinition Height="Auto"/> <!-- Карточка fallback (при ошибке патча) -->
                    <RowDefinition Height="*"/>    <!-- Статус, прогресс и статистика -->
                </Grid.RowDefinitions>

                <!-- МЕТАДАННЫЕ ОБНОВЛЕНИЯ -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <Border CornerRadius="6" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}" 
                            BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="1" 
                            Padding="8,3" Margin="0,0,8,4">
                        <TextBlock x:Name="VersionTransitionText" Text="v3.8.0 ➔ v3.8.0" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>

                    <Border x:Name="PackageBadge" CornerRadius="6" Background="{DynamicResource AccentBrush}" 
                            Padding="8,3" Margin="0,0,8,4">
                        <TextBlock x:Name="PackageBadgeText" Text="⚡ Быстрый патч" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <TextBlock x:Name="TrafficSavingText" Text="Экономия трафика: ~91%" FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                </WrapPanel>

                <!-- УВЕДОМЛЕНИЕ О ПЕРЕХОДЕ НА ПОЛНЫЙ ПАКЕТ (FALLBACK) -->
                <Border x:Name="FallbackNoticeCard" Grid.Row="1" Visibility="Collapsed" CornerRadius="8"
                        Background="#26D97706" BorderBrush="#D97706" BorderThickness="1"
                        Padding="10,6" Margin="0,4,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FallbackNoticeText" Grid.Column="1" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- СТАТУС И ПРОГРЕСС -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock x:Name="StatusText" Text="Подготовка к загрузке..." FontSize="12" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" 
                                 Foreground="{DynamicResource AccentBrush}" BorderThickness="0" 
                                 Background="{DynamicResource LiquidGlassInputBackgroundBrush}"/>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="DownloadStatsText" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- КНОПКИ (ПРИКРЕПЛЕННЫЙ НИЖНИЙ БАР) -->
            <Border Grid.Row="2" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                    BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Style="{StaticResource GlassButton}" Content="Отмена" MinWidth="90" Height="34" Click="CancelBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
