<Window x:Class="Win11CopyDialog.Views.Dialogs.CyberFolderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор папки — Motion Commander"
        Width="880" Height="620" MinWidth="740" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <!-- Корневой контейнер Liquid Glass -->
    <Border x:Name="RootBorder" Style="{StaticResource GlassWindowRoot}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Шапка -->
                <RowDefinition Height="Auto"/> <!-- Полоса быстрого переключения дисков -->
                <RowDefinition Height="*"/>    <!-- Основная рабочая область -->
                <RowDefinition Height="Auto"/> <!-- Нижний HUD и кнопки действий -->
            </Grid.RowDefinitions>

            <!-- 1. ШАПКА ОКНА (Перетаскивание) -->
            <Border Grid.Row="0" Style="{StaticResource GlassDialogTitleBar}"
                    Padding="18,12" MouseDown="Header_MouseDown">
                <DockPanel LastChildFill="True">
                    <!-- Кнопка закрытия -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}" Content="✕" Click="Close_Click" VerticalAlignment="Center"/>

                    <!-- Иконка и заголовки -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LiquidGlassActiveHighlight}"
                                BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DialogTitleText" Text="ВЫБОР ПАПКИ НАЗНАЧЕНИЯ" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="{DynamicResource LiquidGlassActiveHighlight}" BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Liquid Glass Picker" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DialogSubtitleText" Text="Укажите директорию для копирования данных" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. ПОЛОСА НАКОПИТЕЛЕЙ (Drive Selector Strip) -->
            <Border Grid.Row="1" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                    BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="14,8">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="ДИСКИ:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DriveChipsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SidebarDriveCard}" Padding="10,5" Margin="0,0,8,0" CornerRadius="8"
                                            MouseLeftButtonUp="DriveChip_Click" ToolTip="{Binding Title}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Иконка диска -->
                                            <Border Width="20" Height="20" CornerRadius="5" Background="{Binding IconBgBrush}" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{Binding VectorGeometry}" Width="11" Height="11" Stretch="Uniform" Fill="{Binding IconForegroundBrush}"/>
                                                </Grid>
                                            </Border>
                                            <!-- Буква и метка -->
                                            <TextBlock Text="{Binding CleanDriveLetter}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding VolumeLabel}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="80" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <!-- Свободное место -->
                                            <Border Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding BadgeBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FreeSpaceFormatted}" FontSize="9" FontWeight="Bold" Foreground="{Binding UsageBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 3. ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ (Левая панель + Навигатор папок) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Быстрый доступ -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource LiquidGlassMaterialLevel1Brush}">
                    <StackPanel Margin="10,10">
                        <DockPanel Margin="6,2,6,8">
                            <TextBlock Text="БЫСТРЫЙ ДОСТУП" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl x:Name="QuickAccessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarNavItem}" Click="QuickAccessItem_Click">
                                        <DockPanel LastChildFill="True">
                                            <Border Width="24" Height="24" CornerRadius="7" Background="{Binding IconTintBrush}" BorderBrush="{Binding IconBorderBrush}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{Binding VectorGeometry}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding IconForegroundBrush}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Разделитель колонок -->
                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource LiquidGlassInputBorderBrush}"/>

                <!-- Правая колонка: Навигатор папок -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Панель навигации (кнопки, хлебные крошки, поиск) -->
                        <RowDefinition Height="Auto"/> <!-- Инлайн баннер создания папки (скрыт по умолчанию) -->
                        <RowDefinition Height="*"/>    <!-- Список папок -->
                    </Grid.RowDefinitions>

                    <!-- Панель управления и Хлебные крошки -->
                    <Border Grid.Row="0" Style="{StaticResource GlassToolbar}">
                        <DockPanel LastChildFill="True">
                            <!-- Кнопки истории (Назад, Вперед, Вверх, Обновить, Новая папка) -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button x:Name="BackBtn" Style="{StaticResource Win11Button}" Width="28" Height="28" Content="←" ToolTip="Назад" Click="Back_Click"/>
                                <Button x:Name="ForwardBtn" Style="{StaticResource Win11Button}" Width="28" Height="28" Content="→" ToolTip="Вперед" Click="Forward_Click" Margin="2,0,0,0"/>
                                <Button x:Name="UpBtn" Style="{StaticResource Win11Button}" Width="28" Height="28" Content="↑" ToolTip="На уровень вверх" Click="Up_Click" Margin="2,0,0,0"/>
                                <Button Style="{StaticResource Win11Button}" Width="28" Height="28" ToolTip="Обновить" Click="Refresh_Click" Margin="2,0,0,0">
                                    <Path Data="{StaticResource Icon_Refresh}" Width="10.5" Height="10.5" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Style="{StaticResource Win11Button}" Content="➕ Новая папка" Height="28" Padding="10,0" Margin="6,0,0,0" Click="NewFolderToggle_Click"/>
                            </StackPanel>

                            <!-- Поиск / фильтр папок справа -->
                            <Border DockPanel.Dock="Right" Style="{StaticResource GlassSectionCard}" Padding="6,2" Width="160" Margin="8,0,0,0">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="🔍" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FilterBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextChanged="FilterBox_TextChanged" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Интерактивная строка пути (Хлебные крошки) -->
                            <Border Style="{StaticResource GlassSectionCard}" Padding="8,3" VerticalAlignment="Center" Margin="0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="BreadcrumbsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Win11Button}" Content="{Binding Name}" Margin="0,0,2,0" Padding="6,2" FontSize="11" Click="Breadcrumb_Click"/>
                                                    <TextBlock Text="›" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,4,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Инлайн-создание новой папки -->
                    <Border x:Name="NewFolderBanner" Grid.Row="1" Background="{DynamicResource LiquidGlassMaterialLevel3Brush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1"
                            Padding="12,8" Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource AccentButton}" Content="Создать" Height="28" Padding="12,0" Margin="0,0,6,0" Click="CreateFolderConfirm_Click"/>
                                <Button Style="{StaticResource Win11Button}" Content="Отмена" Height="28" Padding="10,0" Click="CreateFolderCancel_Click"/>
                            </StackPanel>
                            <TextBlock Text="Имя новой папки:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="NewFolderNameBox" Height="28" VerticalContentAlignment="Center" Padding="8,0" Style="{StaticResource GlassTextBox}" KeyDown="NewFolderNameBox_KeyDown"/>
                        </DockPanel>
                    </Border>

                    <!-- Основной список подпапок -->
                    <Grid Grid.Row="2">
                        <ListBox x:Name="FoldersListView" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="FoldersListView_MouseDoubleClick"
                                 SelectionChanged="FoldersListView_SelectionChanged"
                                 KeyDown="FoldersListView_KeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Margin" Value="6,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource LiquidGlassSubtleBorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Background="Transparent">
                                        <DockPanel LastChildFill="True">
                                            <!-- Иконка папки -->
                                            <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="📁" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Дата изменения справа -->
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LastModified}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                            <!-- Имя папки и подсказка -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Пустое состояние, если в папке нет вложенных директорий -->
                        <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,8"/>
                            <TextBlock Text="В этой папке нет вложенных директорий" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Вы можете выбрать текущую папку для копирования или создать новую папку кнопкой выше" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 4. НИЖНИЙ HUD И КНОПКИ ДЕЙСТВИЙ -->
            <Border Grid.Row="3" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                    BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Информация о выбранном пути и свободном месте -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="Целевая папка:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource Win11Button}" Content="📋" ToolTip="Скопировать путь" Padding="4,1" Margin="0,0,6,0" Click="CopySelectedPath_Click" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SelectedPathDisplay" Text="C:\" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="DiskSpaceInfoText" Text="Свободно на диске: 0 ГБ" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="RequiredSpaceText" Text="" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Кнопки действий -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Win11Button}" Content="Отмена" MinWidth="90" Height="36" Margin="0,0,8,0" Click="Close_Click"/>
                        <Button x:Name="ConfirmSelectBtn" Style="{StaticResource AccentButton}" Content="⚡ Выбрать эту папку" MinWidth="170" Height="36" Click="ConfirmSelect_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
