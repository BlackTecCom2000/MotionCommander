<Window x:Class="Win11CopyDialog.Views.Dialogs.AdvancedToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продвинутые инструменты — Motion Commander"
        Width="640" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border x:Name="RootBorder" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                              Color="{DynamicResource GlowAccentColor}" Opacity="0.35"/>
        </Border.Effect>

        <DockPanel Margin="18">
            <!-- ШАПКА -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0">
                        <TextBlock Text="🛠" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Инструменты файлов и целостности" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CaptionCloseButton}" Content="✕" Click="Close_Click"/>
            </Grid>

            <!-- ТАБЫ ИНСТРУМЕНТОВ -->
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- 1. ХЭШ-СУММЫ -->
                <TabItem Header="  # Контрольные суммы (Хэши)  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Выберите файл для вычисления хэшей" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Выбрать файл…" Margin="6,0,0,0" Padding="12,4" Click="SelectHashFile_Click"/>
                                        <TextBox x:Name="HashFilePathBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="True"
                                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource SubtleBorderBrush}"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="HashProgress" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- CRC32 -->
                                    <TextBlock Text="CRC32" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                    <DockPanel Margin="0,2,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Копировать" Padding="8,2" Margin="6,0,0,0" Click="CopyCrc_Click"/>
                                        <TextBox x:Name="CrcBox" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontFamily="Consolas"/>
                                    </DockPanel>

                                    <!-- MD5 -->
                                    <TextBlock Text="MD5" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                    <DockPanel Margin="0,2,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Копировать" Padding="8,2" Margin="6,0,0,0" Click="CopyMd5_Click"/>
                                        <TextBox x:Name="Md5Box" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontFamily="Consolas"/>
                                    </DockPanel>

                                    <!-- SHA-256 -->
                                    <TextBlock Text="SHA-256" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                    <DockPanel Margin="0,2,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Копировать" Padding="8,2" Margin="6,0,0,0" Click="CopySha256_Click"/>
                                        <TextBox x:Name="Sha256Box" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontFamily="Consolas"/>
                                    </DockPanel>

                                    <!-- SHA-512 -->
                                    <TextBlock Text="SHA-512" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                    <DockPanel Margin="0,2,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Копировать" Padding="8,2" Margin="6,0,0,0" Click="CopySha512_Click"/>
                                        <TextBox x:Name="Sha512Box" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontFamily="Consolas"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Проверка соответствия хэша -->
                            <Border Style="{StaticResource Card}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Проверка соответствия (вставьте ожидаемый хэш)" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ExpectedHashBox" Height="30" VerticalContentAlignment="Center" Padding="8,0"
                                             TextChanged="ExpectedHashBox_TextChanged"/>
                                    <TextBlock x:Name="HashMatchText" FontSize="12" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2. СРАВНЕНИЕ ФАЙЛОВ -->
                <TabItem Header="  ⇄ Бинарное сравнение файлов  ">
                    <StackPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Первый файл" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Выбрать…" Margin="6,0,0,0" Padding="12,3" Click="SelectFile1_Click"/>
                                    <TextBox x:Name="File1Box" Height="30" VerticalContentAlignment="Center" Padding="6,0" IsReadOnly="True"/>
                                </DockPanel>

                                <TextBlock Text="Второй файл" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Выбрать…" Margin="6,0,0,0" Padding="12,3" Click="SelectFile2_Click"/>
                                    <TextBox x:Name="File2Box" Height="30" VerticalContentAlignment="Center" Padding="6,0" IsReadOnly="True"/>
                                </DockPanel>

                                <Button x:Name="CompareBtn" Style="{StaticResource CyberButton}" Content="⚡ Сравнить побайтово" Height="34" Margin="0,12,0,0" Click="CompareFiles_Click"/>
                                <ProgressBar x:Name="CompareProgress" Height="4" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Результат сравнения" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CompareResultText" Text="Выберите два файла для побайтовой верификации." FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- 3. АНАЛИЗ ПАПКИ -->
                <TabItem Header="  📊 Анализ размера папки  ">
                    <StackPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Выберите папку для глубокого сканирования" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Win11Button}" Content="Обзор…" Margin="6,0,0,0" Padding="12,3" Click="SelectFolderAnalyze_Click"/>
                                    <TextBox x:Name="AnalyzeFolderBox" Height="30" VerticalContentAlignment="Center" Padding="6,0" IsReadOnly="True"/>
                                </DockPanel>
                                <Button x:Name="StartAnalyzeBtn" Style="{StaticResource CyberButton}" Content="🔍 Сканировать размер" Height="34" Click="StartAnalyze_Click"/>
                                <ProgressBar x:Name="AnalyzeProgress" Height="4" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Итоги сканирования" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AnalyzeResultText" Text="Выберите папку и нажмите «Сканировать размер»." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="AnalyzeDetailText" Text="" FontSize="11" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
