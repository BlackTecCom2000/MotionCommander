<Window x:Class="Win11CopyDialog.Views.Dialogs.DuplicateFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск и очистка дубликатов файлов — Motion Commander"
        Height="700" Width="1050" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource GlassWindowRoot}">
        <DockPanel>
            <!-- ШАПКА -->
            <Border DockPanel.Dock="Top" Style="{StaticResource GlassDialogTitleBar}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LiquidGlassActiveHighlight}"
                                BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Поиск и безопасная очистка дубликатов файлов" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="3-уровневый алгоритм (Размер → Пре-хэш 4 КБ → Полный SHA-256) для мгновенного нахождения копий" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource CaptionCloseButton}" Content="✕" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- НИЖНИЙ СТАТУС-БАР -->
            <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <ProgressBar x:Name="SearchProgress" DockPanel.Dock="Right" Width="180" Height="6" IsIndeterminate="True" Visibility="Collapsed" BorderThickness="0" Background="{DynamicResource LiquidGlassInputBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Готово к поиску. Выберите папку для проверки." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DockPanel>
            </Border>

            <!-- ТЕЛО -->
            <Grid Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель настроек поиска -->
                <Border Grid.Row="0" Style="{StaticResource GlassSectionCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Папка поиска:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                            <TextBox x:Name="SearchFolderBox" Grid.Column="1" Style="{StaticResource GlassTextBox}"
                                     Padding="8,4" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource GlassButton}" Content="📂 Обзор..." Margin="8,0,0,0" Padding="14,0" Height="34" Click="BrowseFolder_Click"/>
                            <Button x:Name="StartSearchBtn" Grid.Column="3" Style="{StaticResource GlassPrimaryButton}" Content="⚡ Искать дубликаты" Margin="8,0,0,0" Padding="16,0" Height="34" Click="StartSearch_Click"/>
                        </Grid>

                        <DockPanel Grid.Row="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Минимальный размер файла:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="MinSizeCombo" Width="130" SelectedIndex="1">
                                    <ComboBoxItem Content="Любой размер"/>
                                    <ComboBoxItem Content="> 1 МБ"/>
                                    <ComboBoxItem Content="> 10 МБ"/>
                                    <ComboBoxItem Content="> 100 МБ"/>
                                    <ComboBoxItem Content="> 1 ГБ"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GlassButton}" Content="☑ Отметить все копии (оставить 1)" Margin="0,0,8,0" Padding="12,0" Height="32" Click="SelectAllDuplicates_Click"/>
                                <Button Style="{StaticResource GlassButton}" Content="☐ Снять выбор" Margin="0,0,8,0" Padding="12,0" Height="32" Click="DeselectAll_Click"/>
                                <Button x:Name="DeleteSelectedBtn" Style="{StaticResource GlassPrimaryButton}" Content="🗑 Удалить выбранные (0)" Padding="14,0" Height="32" Click="DeleteSelected_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Список найденных дубликатов -->
                <Border Grid.Row="1" Style="{StaticResource GlassSectionCard}" Margin="0" Padding="4">
                    <ListView x:Name="DuplicatesListView" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="CheckChanged" Unchecked="CheckChanged"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Группа" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource LiquidGlassActiveHighlight}" BorderBrush="{DynamicResource DialogChromaticBevel}" BorderThickness="1" CornerRadius="6" Padding="6,1" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding GroupIndex}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Имя файла" Width="260">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Размер" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Дата изменения" Width="140" DisplayMemberBinding="{Binding DateModifiedFormatted}"/>
                                <GridViewColumn Header="Каталог расположения" Width="400" DisplayMemberBinding="{Binding DirectoryPath}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
