<Window x:Class="Win11CopyDialog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Win11CopyDialog.Controls"
        xmlns:storage="clr-namespace:Win11CopyDialog.Modules.StorageControlCenter.Views"
        xmlns:uninstaller="clr-namespace:Win11CopyDialog.Modules.Utilities.Uninstaller.Views"
        xmlns:dm="clr-namespace:Win11CopyDialog.Modules.Utilities.DownloadManager.Views"
        xmlns:models="clr-namespace:Win11CopyDialog.Models"
        Title="Motion Commander — Все-в-одном Файловый Менеджер и Архиватор"
        Height="780" Width="1160"
        MinWidth="920" MinHeight="620"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 1. Single File Context Menu -->
        <ContextMenu x:Key="FileContextMenu">
            <MenuItem Header="Открыть" InputGestureText="Enter" Click="ContextOpen_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_OpenFolder}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Сжать в архив…" Click="ContextCompress_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Archive}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="FileExtractMenuItem" Header="Распаковать архив…" Click="ContextExtract_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Extract}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Хэш-суммы (CRC32, SHA-256)" Click="ContextHashes_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Hashes}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Click="CopyItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Copy}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Вырезать" InputGestureText="Ctrl+X" Click="CutItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Cut}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="FilePasteMenuItem" Header="Вставить" InputGestureText="Ctrl+V" Click="PasteItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Paste}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Копировать в папку…" Click="CopyToFolder_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Transfer}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Переместить в папку…" Click="MoveToFolder_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Move}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Дублировать" InputGestureText="Ctrl+D" Click="ContextDuplicate_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Duplicate}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Переименовать" InputGestureText="F2" Click="ContextRename_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Rename}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Удалить" InputGestureText="Del" Tag="Danger" Click="DeleteItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Delete}" Fill="{DynamicResource ContextMenuDanger}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Свойства" InputGestureText="Alt+Enter" Click="ContextProperties_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Properties}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- 2. Single Folder Context Menu -->
        <ContextMenu x:Key="FolderContextMenu">
            <MenuItem Header="Открыть" InputGestureText="Enter" Click="ContextOpen_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Folder}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Открыть в терминале" Click="ContextTerminal_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Terminal}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Сжать папку в архив…" Click="ContextCompress_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Archive}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Click="CopyItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Copy}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Вырезать" InputGestureText="Ctrl+X" Click="CutItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Cut}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="FolderPasteMenuItem" Header="Вставить" InputGestureText="Ctrl+V" Click="PasteItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Paste}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Копировать в папку…" Click="CopyToFolder_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Transfer}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Переместить в папку…" Click="MoveToFolder_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Move}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Переименовать" InputGestureText="F2" Click="ContextRename_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Rename}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Удалить" InputGestureText="Del" Tag="Danger" Click="DeleteItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Delete}" Fill="{DynamicResource ContextMenuDanger}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Свойства" InputGestureText="Alt+Enter" Click="ContextProperties_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Properties}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- 3. Multiple Selection Context Menu -->
        <ContextMenu x:Key="MultiSelectionContextMenu">
            <MenuItem Header="Сжать выбранное в архив…" Click="ContextCompress_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Archive}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MultiExtractMenuItem" Header="Распаковать выбранные архивы…" Click="ContextExtract_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Extract}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Хэш-суммы выбранных файлов" Click="ContextHashes_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Hashes}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Click="CopyItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Copy}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Вырезать" InputGestureText="Ctrl+X" Click="CutItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Cut}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Копировать в папку…" Click="CopyToFolder_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Transfer}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Переместить в папку…" Click="MoveToFolder_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Move}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Удалить выбранные" InputGestureText="Del" Tag="Danger" Click="DeleteItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Delete}" Fill="{DynamicResource ContextMenuDanger}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- 4. Background (Empty Area) Context Menu -->
        <ContextMenu x:Key="BackgroundContextMenu">
            <MenuItem x:Name="BgNewFolderMenuItem" Header="Создать папку" InputGestureText="Ctrl+Shift+N" Click="NewFolder_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_NewFolder}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="BgPasteMenuItem" Header="Вставить" InputGestureText="Ctrl+V" Click="PasteItem_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Paste}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Выделить всё" InputGestureText="Ctrl+A" Click="SelectAll_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_SelectAll}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="BgTerminalMenuItem" Header="Открыть в терминале" Click="BackgroundTerminal_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Terminal}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Обновить" InputGestureText="F5" Click="Refresh_Click">
                <MenuItem.Icon>
                    <Path Data="{StaticResource Icon_Refresh}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12,12,12,12"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource LiquidGlassMaterialLevel0Brush}"
            BorderBrush="{DynamicResource LiquidGlassBorderLevel2Brush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusWindow}">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Border.LayoutTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Toolbar & Path -->
                <RowDefinition Height="*" /> <!-- Main Area -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>


            <!-- ══ STARFIELD BACKDROP (ports the React/CSS starfield card component) ══
                 Three animated star layers scrolling from Y=0 → -2000px in 50/100/150s cycles.
                 Deep space radial gradient: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%)
                 Renders below the liquid-glass chromatic glows so they overlay on top.

                 Раньше фон горел во всех темах без исключения, включая светлые,
                 и анимировался даже в свёрнутом окне. Теперь он включается
                 только для тем с живым фоном (Cosmic Nebula, Deep Sea, Motion Glass)
                 и выключается в режиме «Эконом». -->
            <!-- КОСМИЧЕСКАЯ СЦЕНА.

                 CosmicBackdrop заменяет прежний StarfieldControl: планета с
                 настоящим сферическим терминатором, объёмная туманность,
                 звёзды с цветом по температуре и параллаксом от курсора,
                 падающие звёзды.

                 Старый StarfieldControl остаётся в проекте и подключается
                 отдельной строкой ниже как запасной путь: если новая сцена
                 покажет себя хуже, фон вернётся одним изменением.

                 Видимостью управляет ApplyLiveBackdropState() из кода:
                 фон включается только для тёмных тем с живым фоном и
                 выключается в режиме «Эконом». -->
            <ctrl:CosmicBackdrop x:Name="LiveStarfield" Grid.RowSpan="4" IsHitTestVisible="False"/>

            <!-- Fluid Optical Backdrop Layer (Ambient Cyan & Violet Luminous Glows under frosted glass - 2211.zip) -->
            <Canvas Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True">
                <!-- Top-Left Cyan Luminous Aura -->

                <Ellipse Width="460" Height="460" Canvas.Left="-100" Canvas.Top="-100" Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#00E5FF" Offset="0.0"/>
                            <GradientStop Color="#0078D4" Offset="0.45"/>
                            <GradientStop Color="Transparent" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Center-Right Violet / Magenta Chromatic Glow -->
                <Ellipse Width="550" Height="550" Canvas.Right="-150" Canvas.Top="100" Opacity="0.10">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#B366FF" Offset="0.0"/>
                            <GradientStop Color="#F43F5E" Offset="0.4"/>
                            <GradientStop Color="Transparent" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Bottom-Left Deep Sapphire Glow -->
                <Ellipse Width="480" Height="480" Canvas.Left="120" Canvas.Bottom="-140" Opacity="0.08">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#3B82F6" Offset="0.0"/>
                            <GradientStop Color="#1D4ED8" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
            <!-- ШАПКА ОКНА (Header with Navigation Tabs) -->
            <Border Grid.Row="0" Height="56" Background="{DynamicResource LiquidGlassMaterialLevel1Brush}"
                    BorderBrush="{DynamicResource LiquidGlassSubtleBorderBrush}" BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Брендовый заголовок -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="{DynamicResource GlowAccentColor}" Opacity="0.8"/>
                            </Border.Effect>
                            <TextBlock Text="✦" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Motion Commander" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" FontSize="14" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource MediaNVMeBackground}" BorderBrush="{DynamicResource LiquidGlassSubtleBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusPill}" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AppVersionHeaderBadgeText" Text="v3.8.13 All-in-One" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MediaNVMeBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="SelectVersionBtn" Style="{StaticResource CaptionButton}" ToolTip="Выбор версии и откат назад (Time Machine)" Click="SelectVersionBtn_Click" Margin="6,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Версии" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CheckUpdatesBtn" Style="{StaticResource CaptionButton}" ToolTip="Проверить обновления" Click="CheckUpdatesBtn_Click" Margin="4,0,0,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource Icon_Refresh}" Fill="{DynamicResource TitleForegroundBrush}" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Вкладки верхнего уровня (Футуристический Liquid Glass док с мягким бесшовным свечением) -->
                    <Border Grid.Column="1" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}" CornerRadius="{DynamicResource RadiusFloating}"
                            Padding="3" BorderBrush="{DynamicResource GlassBorderSubtle}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Direction="270"
                                              Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                            <RadioButton x:Name="TabFilesRadio" Style="{StaticResource FuturisticNavTab}"
                                         GroupName="TopNav" IsChecked="True" Click="NavTab_Click" Checked="NavTab_Checked" PreviewMouseLeftButtonDown="NavTab_PreviewMouseDown">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon_NavFiles}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Файлы" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabTransferRadio" Style="{StaticResource FuturisticNavTab}"
                                         GroupName="TopNav" Click="NavTab_Click" Checked="NavTab_Checked" PreviewMouseLeftButtonDown="NavTab_PreviewMouseDown">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon_NavSpeed}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Скорость" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabStorageRadio" Style="{StaticResource FuturisticNavTab}"
                                         GroupName="TopNav" Click="NavTab_Click" Checked="NavTab_Checked" PreviewMouseLeftButtonDown="NavTab_PreviewMouseDown">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon_NavStorage}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Накопители" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabDiagnosticsRadio" Style="{StaticResource FuturisticNavTab}"
                                         GroupName="TopNav" Click="NavTab_Click" Checked="NavTab_Checked" PreviewMouseLeftButtonDown="NavTab_PreviewMouseDown">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon_NavDiagnostics}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Диагностика" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabToolsRadio" Style="{StaticResource FuturisticNavTab}"
                                         GroupName="TopNav" Click="NavTab_Click" Checked="NavTab_Checked" PreviewMouseLeftButtonDown="NavTab_PreviewMouseDown">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon_NavTools}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Утилиты" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Быстрые переключатели: Поиск, Очередь, Масштаб, Окно настроек и тема -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="GlobalSearchHeaderBtn" Style="{StaticResource CaptionButton}"
                                ToolTip="Глобальный поиск и палитра команд (Ctrl+K)" Click="GlobalSearchHeaderBtn_Click" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Поиск" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OperationsQueueHeaderBtn" Style="{StaticResource CaptionButton}"
                                ToolTip="Очередь операций: Копирование, Загрузки, Архивы (Ctrl+Q)" Click="OperationsQueueHeaderBtn_Click" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QueueCountBadgeText" Text="Очередь (0)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="UiScaleCombo" Width="68" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"
                                  ToolTip="Масштаб интерфейса (доступность)"
                                  SelectionChanged="UiScaleCombo_SelectionChanged"
                                  Background="{DynamicResource LiquidGlassInputBackgroundBrush}"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource GlassBorderSubtle}">
                            <ComboBoxItem Content="100%" IsSelected="True" Tag="1.0"/>
                            <ComboBoxItem Content="115%" Tag="1.15"/>
                            <ComboBoxItem Content="125%" Tag="1.25"/>
                            <ComboBoxItem Content="150%" Tag="1.5"/>
                        </ComboBox>
                        <Button x:Name="OpenSettingsWindowBtn" Style="{StaticResource CaptionButton}"
                                ToolTip="Настройки и Опции" Click="OpenSettingsWindow_Click" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="{StaticResource Icon_NavSettings}" Fill="{DynamicResource TitleForegroundBrush}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="QuickThemeBtn" Style="{StaticResource CaptionButton}"
                                ToolTip="Переключение Светлая / Тёмная" Click="QuickTheme_Click" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="QuickThemeIcon" Text="☾" FontSize="13" Foreground="{DynamicResource TitleForegroundBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Кнопки управления окном -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="AvailableUpdateBtn" Style="{StaticResource CaptionButton}" ToolTip="Доступно обновление!" Click="AvailableUpdateBtn_Click" Visibility="Collapsed" Margin="0,0,4,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Обновить" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="─" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" ToolTip="Развернуть" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="MaxBtnGlyph" Text="□" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButton}" ToolTip="Закрыть" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ОСНОВНОЙ КОНТЕНТ (5 ВКЛАДОК) -->
                <!-- ================= 1. ФАЙЛЫ И АРХИВЫ ================= -->
            <!-- TOOLBAR -->
            <StackPanel x:Name="FileBrowserToolbarPanel" Grid.Row="1">
                <!-- Панель команд (Floating Glass Ribbon Dock) -->
                <Border Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                        BorderBrush="{DynamicResource LiquidGlassSubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
                    <DockPanel LastChildFill="True">
                        <!-- Правая часть: Скрытые файлы и Обновить (всегда прижаты вправо и гарантированно видимы) -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <CheckBox x:Name="ShowHiddenCheck" Content="Скрытые" Foreground="{DynamicResource PrimaryTextBrush}"
                                      FontSize="11" FontWeight="Medium" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0" Click="ShowHidden_Click"
                                      ToolTip="Показывать скрытые файлы и папки"/>
                            <Button Style="{StaticResource CyberNavCircleButton}" ToolTip="Обновить список (F5)" Click="Refresh_Click">
                                <Path Data="{StaticResource Icon_Refresh}" Fill="{DynamicResource PrimaryTextBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Основные действия с файлами и архивами (горизонтальный скроллинг без наложения) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False" PanningMode="HorizontalOnly">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CreateArchiveBtn" Style="{StaticResource RibbonPrimaryActionButton}"
                                        Click="CreateArchive_Click" ToolTip="Создать новый архив из выбранных файлов">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Archive}" Fill="{DynamicResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Архив" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExtractArchiveBtn" Style="{StaticResource RibbonActionButton}"
                                        Click="ExtractArchive_Click" ToolTip="Распаковать архив в папку">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Extract}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Распаковать" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TestArchiveBtn" Style="{StaticResource RibbonActionButton}"
                                        Click="TestArchive_Click" ToolTip="Проверить целостность архива">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Shield}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Тест" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Separator Style="{StaticResource LiquidGlassDividerVertical}" Height="18" Margin="8,0"/>

                                <Button Style="{StaticResource RibbonActionButton}" Click="CopyItem_Click" ToolTip="Копировать в буфер обмена (Ctrl+C)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Copy}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Копия" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="CutItem_Click" ToolTip="Вырезать в буфер обмена (Ctrl+X)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Cut}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Вырезать" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="PasteItem_Click" ToolTip="Вставить из буфера обмена (Ctrl+V)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Paste}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Вставить" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="DeleteItem_Click" ToolTip="Удалить выбранные элементы (Del)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Delete}" Fill="#EF4444" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="NewFolder_Click" ToolTip="Создать новую папку (Ctrl+Shift+N)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_NewFolder}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Папка" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="ShowHashes_Click" ToolTip="Вычисление контрольных сумм MD5, SHA-256">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Hashes}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Хэши" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="ContextRename_Click" ToolTip="Переименовать выбранный элемент (F2)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Rename}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Имя" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="MoveToFolder_Click" ToolTip="Переместить в другую папку (F6)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Move}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Перенос" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="ContextProperties_Click" ToolTip="Свойства выбранного элемента (Alt+Enter)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Properties}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Свойства" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonActionButton}" Click="SelectAll_Click" ToolTip="Выделить все элементы (Ctrl+A)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_SelectAll}" Fill="{DynamicResource PrimaryTextBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                        <TextBlock Text="Выделить всё" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Width="1" Height="18" Fill="{DynamicResource LiquidGlassSubtleBorderBrush}" Margin="5,0,6,0"/>

                                <Button x:Name="QuickScenarioCleanupBtn" Style="{StaticResource RibbonActionButton}" Click="QuickScenarioCleanupBtn_Click" ToolTip="Сценарий: Экспресс-очистка временных файлов и кэша">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧹" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Освободить место" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="QuickScenarioPrepareCopyBtn" Style="{StaticResource RibbonActionButton}" Click="QuickScenarioPrepareCopyBtn_Click" ToolTip="Сценарий: Проверка диска, TRIM и оптимизация перед большим копированием">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🚀" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Подготовить диск" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Width="1" Height="18" Fill="{DynamicResource LiquidGlassSubtleBorderBrush}" Margin="5,0,6,0"/>

                                <Button x:Name="OpenFileManagerBtn" Style="{StaticResource RibbonPrimaryActionButton}" Click="OpenFileManager_Click" ToolTip="Открыть автономный файловый менеджер (Motion UI)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon_Folder}" Fill="{DynamicResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Файловый менеджер" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Строка пути и Поиск (Мягкий бесшовный док) -->
                <Border Background="{DynamicResource LiquidGlassMaterialLevel1Brush}" Padding="10,6" BorderBrush="{DynamicResource GlassBorderSubtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200" MinWidth="120" MaxWidth="260"/>
                        </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Button x:Name="BackBtn" Style="{StaticResource CyberNavCircleButton}" ToolTip="Назад" Click="Back_Click">
                                        <Path Data="{StaticResource Icon_ChevronLeft}" Fill="{DynamicResource PrimaryTextBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="ForwardBtn" Style="{StaticResource CyberNavCircleButton}" ToolTip="Вперёд" Click="Forward_Click">
                                        <Path Data="{StaticResource Icon_ChevronRight}" Fill="{DynamicResource PrimaryTextBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                    <Button x:Name="UpBtn" Style="{StaticResource CyberNavCircleButton}" ToolTip="Вверх" Click="Up_Click">
                                        <Path Data="{StaticResource Icon_ChevronUp}" Fill="{DynamicResource PrimaryTextBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource LiquidGlassInputBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderSubtle}"
                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}" Padding="8,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource MediaNVMeBackground}" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0">
                                            <Path Data="{StaticResource Icon_Folder}" Fill="{DynamicResource MediaNVMeBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox x:Name="PathBox" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" KeyDown="PathBox_KeyDown"/>
                                        <Button x:Name="FavoriteBtn" Grid.Column="2" Style="{StaticResource CaptionButton}" Width="26" Height="24" ToolTip="Добавить / Удалить из Избранного" Click="FavoriteBtn_Click" Margin="2,0,0,0">
                                            <TextBlock x:Name="FavoriteIcon" Text="☆" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource CaptionButton}" Width="26" Height="24" ToolTip="Скопировать путь" Click="CopyCurrentPath_Click" Margin="2,0,0,0">
                                            <Path Data="{StaticResource Icon_Copy}" Fill="{DynamicResource SecondaryTextBrush}" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Margin="8,0,0,0" Background="{DynamicResource LiquidGlassInputBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderSubtle}"
                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}" Padding="8,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource Icon_Search}" Fill="{DynamicResource SecondaryTextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="2,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                                 TextChanged="SearchBox_TextChanged"/>
                                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Style="{StaticResource CaptionButton}" Width="22" Height="22" ToolTip="Очистить поиск" Click="ClearSearch_Click" Visibility="Collapsed">
                                            <Path Data="{StaticResource Icon_Close}" Fill="{DynamicResource SecondaryTextBrush}" Width="9" Height="9" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        
            </StackPanel>

            <!-- MAIN AREA -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="350"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220" MinWidth="160" MaxWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource LiquidGlassMaterialLevel1Brush}">
                    <DockPanel LastChildFill="True">
<!-- Левая панель навигации: Быстрый доступ и Накопители -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <StackPanel Margin="10,8">
                                    
                                    <!-- Заголовок: Быстрый доступ -->
                                    <DockPanel Margin="6,2,6,8">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="SidebarQuickAccessCountBadge" Text="7" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="БЫСТРЫЙ ДОСТУП" FontSize="10.5" FontWeight="Bold" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Список папок быстрого доступа -->
                                    <ItemsControl x:Name="QuickAccessList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SidebarNavItem}" Click="QuickAccess_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Открыть" Click="QuickAccessContextOpen_Click">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource Icon_OpenFolder}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Открыть в терминале" Click="QuickAccessContextTerminal_Click">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource Icon_Terminal}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Копировать путь" Click="QuickAccessContextCopyPath_Click">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource Icon_Copy}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <DockPanel LastChildFill="True">
                                                        <!-- Иконка в мягком цветном бейдже -->
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="{Binding IconTintBrush}" BorderBrush="{Binding IconBorderBrush}" BorderThickness="1" Margin="0,0,9,0" VerticalAlignment="Center">
                                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="{Binding VectorGeometry}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding IconForegroundBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Шеврон перехода справа -->
                                                        <TextBlock DockPanel.Dock="Right" Text="›" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   Opacity="0.4" VerticalAlignment="Center" Margin="4,0,2,0"/>

                                                        <!-- Название и назначение папки -->
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Мягкий разделитель Liquid Glass между секциями сайдбара -->
                                    <Separator Style="{StaticResource LiquidGlassDividerSubtle}" Margin="4,12,4,8"/>

                                    <!-- Заголовок: Диски и накопители -->
                                    <DockPanel Margin="6,4,6,8">
                                        <!-- Справа: кнопка обновить и бейдж количества томов -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="SidebarDrivesCountBadge" Text="4 тома" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <Button Style="{StaticResource CyberNavCircleButton}" Width="24" Height="24" ToolTip="Обновить список дисков" Click="RefreshDrives_Click" Margin="0">
                                                <Path Data="{StaticResource Icon_Refresh}" Width="10.5" Height="10.5" Stretch="Uniform" Fill="{DynamicResource SecondaryTextBrush}"/>
                                            </Button>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💽" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ДИСКИ И НАКОПИТЕЛИ" FontSize="10.5" FontWeight="Bold" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Список дисков и накопителей системы -->
                                    <ItemsControl x:Name="DrivesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SidebarDriveCard}" MouseLeftButtonUp="Drive_Click">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Открыть диск" Click="DriveContextOpen_Click">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource Icon_Folder}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Анализ диска (WizTree)" Click="DriveContextWizTree_Click">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource Icon_NavDiagnostics}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Тест скорости накопителя" Click="DriveContextSpeed_Click">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource Icon_NavSpeed}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="Свойства диска" Click="DriveContextProperties_Click">
                                                                <MenuItem.Icon>
                                                                    <Path Data="{StaticResource Icon_Properties}" Fill="{DynamicResource ContextMenuForeground}" Width="14" Height="14" Stretch="Uniform"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel>
                                                        <!-- Верхняя строка: Иконка, Имя, Подзаголовок, Справа бейдж ФС и % -->
                                                        <DockPanel Margin="0,0,0,6">
                                                            <!-- Справа: Двухцветный бейдж (ФС • Процент) - НИКОГДА НЕ ПУСТОЙ! -->
                                                            <Border DockPanel.Dock="Right" Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding BadgeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7,2" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DriveBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                                    <TextBlock Text=" • " FontSize="9.5" Foreground="{DynamicResource SubtleBorderBrush}"/>
                                                                    <TextBlock Text="{Binding PercentFormatted}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding UsageBrush}"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Слева: Иконка в цветном бейдже с подсветкой -->
                                                            <Border Width="28" Height="28" CornerRadius="7" Background="{Binding IconBgBrush}" BorderBrush="{Binding IconBorderBrush}" BorderThickness="1" Margin="0,0,9,0" VerticalAlignment="Center">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Path Data="{Binding VectorGeometry}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding IconForegroundBrush}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Заголовок диска и описание -->
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <!-- Прогресс-бар с плавным градиентом заполнения -->
                                                        <ProgressBar Height="6" Margin="0,2,0,5" Minimum="0" Maximum="100" Value="{Binding PercentUsed, Mode=OneWay}"
                                                                     BorderThickness="0" Background="{DynamicResource ProgressTrackBrush}" Foreground="{Binding UsageGradientBrush}"/>

                                                        <!-- Нижняя строка: Свободное место и общий объем -->
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalSpaceFormatted}" FontSize="9.5" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding FreeSpaceFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Сводка общего дискового пространства системы -->
                                    <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,6,0,12">
                                        <DockPanel LastChildFill="True">
                                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource GlassBorderSubtle}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="📊" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Все накопители системы" FontSize="9" Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="SidebarStorageSummaryText" Text="Загрузка хранилищ…" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            
                    </DockPanel>
                </Border>
                
                <!-- МЯГКИЙ ИНТЕРАКТИВНЫЙ СПЛИТТЕР LIQUID GLASS (САЙДБАР ↔ РАБОЧАЯ ОБЛАСТЬ) -->
                <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Style="{StaticResource LiquidGlassSplitter}"/>

                <!-- WORKSPACE -->
                <Grid x:Name="FilesViewContainer" Grid.Column="2" Margin="10">
                    <Grid x:Name="FilesView" Visibility="Visible">
<!-- Правая панель: Файловый браузер -->
                            <ListView x:Name="FileBrowserList" BorderThickness="0" Background="Transparent"
                                      AllowDrop="True" Drop="FileBrowserList_Drop" MouseDoubleClick="FileBrowserList_DoubleClick"
                                      SelectionChanged="FileBrowserList_SelectionChanged" KeyDown="FileBrowserList_KeyDown"
                                      PreviewMouseRightButtonDown="FileBrowserList_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="FileBrowserList_ContextMenuOpening">

                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Имя" Width="240">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Размер" Width="85" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                        <GridViewColumn Header="Сжатый" Width="85" DisplayMemberBinding="{Binding PackedSizeFormatted}"/>
                                        <GridViewColumn Header="Сжатие" Width="70" DisplayMemberBinding="{Binding CompressionRatioFormatted}"/>
                                        <GridViewColumn Header="Изменён" Width="125" DisplayMemberBinding="{Binding DateModifiedFormatted}"/>
                                        <GridViewColumn Header="Атрибуты" Width="75" DisplayMemberBinding="{Binding AttributesFormatted}"/>
                                        <GridViewColumn Header="CRC32" Width="80" DisplayMemberBinding="{Binding CrcHex}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        
                    </Grid>
                </Grid>

                <!-- МЯГКИЙ ИНТЕРАКТИВНЫЙ СПЛИТТЕР LIQUID GLASS (РАБОЧАЯ ОБЛАСТЬ ↔ ИНСПЕКТОР) -->
                <GridSplitter x:Name="RightSplitter" Grid.Column="3" Style="{StaticResource LiquidGlassSplitter}"/>

                <!-- INSPECTOR -->
                <Border x:Name="InspectorBorder" Grid.Column="4" Background="{DynamicResource LiquidGlassMaterialLevel1Brush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <TextBlock Text="СВОЙСТВА" FontSize="11" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="InspectorItemName" Text="Выберите элемент" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="InspectorItemType" Text="Файлы и папки" FontSize="10.5" Style="{StaticResource MutedText}" Margin="0,2,0,6"/>
                                    <Separator Margin="0,4,0,6" Background="{DynamicResource LiquidGlassSubtleBorderBrush}"/>
                                    <TextBlock x:Name="InspectorItemSize" Text="Размер: —" FontSize="10.5" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="InspectorItemDate" Text="Изменён: —" FontSize="10.5" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="InspectorItemPath" Text="Путь: —" FontSize="9.5" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="MOTION AI" FontSize="11" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,0,0,8" Visibility="{Binding Path=AiVisibility, Source={x:Static models:ThemeManager.Instance}}"/>
                            <Border Style="{StaticResource Card}" Padding="12" Visibility="{Binding Path=AiVisibility, Source={x:Static models:ThemeManager.Instance}}">
                                <TextBlock Text="AI-аналитика готова" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Style="{StaticResource MutedText}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

<!-- ================= 2. ДВИЖОК ПЕРЕДАЧ (MOTION TRANSFER ENGINE) ================= -->
                <Grid x:Name="TransferView" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed" Margin="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="880" HorizontalAlignment="Center">
                            <!-- Селектор источника и назначения передачи данных -->
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Аппаратный движок прямой передачи данных (Direct I/O Streamer)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Прямой конвейер потокового ввода-вывода с нулевым оверхедом и аппаратным насыщением шины" FontSize="11" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Пути источник / назначение -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Источник:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBox x:Name="TransferSourceBox" Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Padding="8,6" VerticalAlignment="Center"
                                                 AllowDrop="True" PreviewDragOver="TransferPath_DragOver" Drop="TransferSource_Drop"/>
                                        <Button Grid.Column="2" Style="{StaticResource CyberToolButton}" Content="📄 Файл..." Margin="8,0,0,0" Padding="10,6" Click="BrowseSourceFile_Click"/>
                                        <Button Grid.Column="3" Style="{StaticResource CyberToolButton}" Content="📁 Папка..." Margin="6,0,0,0" Padding="10,6" Click="BrowseSourceFolder_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Приёмник:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBox x:Name="TransferDestBox" Grid.Column="1" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Padding="8,6" VerticalAlignment="Center"
                                                 AllowDrop="True" PreviewDragOver="TransferPath_DragOver" Drop="TransferDest_Drop"/>
                                        <Button Grid.Column="2" Style="{StaticResource CyberToolButton}" Content="📁 Папка..." Margin="8,0,0,0" Padding="12,6" Click="BrowseDestFolder_Click"/>
                                    </Grid>

                                    <!-- Панель запуска -->
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="StartTransferBtn" Style="{StaticResource CyberButton}" Content="⚡ Старт передачи" Padding="18,8" Click="StartLiveTransfer_Click"/>
                                            <Button x:Name="PauseTransferBtn" Style="{StaticResource CyberToolButton}" Content="⏸ Пауза" Margin="8,0,0,0" Padding="14,8" IsEnabled="False" Click="PauseLiveTransfer_Click"/>
                                            <Button x:Name="CancelTransferBtn" Style="{StaticResource CyberToolButton}" Content="⏹ Стоп" Margin="8,0,0,0" Padding="14,8" IsEnabled="False" Click="CancelLiveTransfer_Click"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource CyberToolButton}" Content="🚀 3D Окно Motion Copy" HorizontalAlignment="Right" Padding="14,8" Click="OpenMotionWindow_Click"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Неоновый телеметрический HUD (4 плашки) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Скорость сейчас -->
                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="ТЕКУЩАЯ СКОРОСТЬ" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="HudCurrentSpeedText" Text="0.0 МБ/с" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="HudBusType" Text="I/O Stream Ready" FontSize="10" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Пиковая скорость -->
                                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="ПИКОВАЯ СКОРОСТЬ" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="HudPeakSpeedText" Text="0.0 МБ/с" FontSize="18" FontWeight="Bold" Foreground="#00FF66" Margin="0,4,0,0"/>
                                        <TextBlock Text="Hardware Max Bus" FontSize="10" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ETA -->
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="ОСТАВШЕЕСЯ ВРЕМЯ" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="HudEtaText" Text="--:--:--" FontSize="18" FontWeight="Bold" Foreground="#FFD600" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="HudAvgSpeedText" Text="Средняя: 0 МБ/с" FontSize="10" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Прогресс и объем -->
                                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ПЕРЕДАНО ДАННЫХ" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="HudProgressText" Text="0% (0 / 0)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="HudBytesText" Text="0 МБ из 0 МБ" FontSize="10" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Индикатор узких мест (Bottleneck Detector) -->
                            <Border x:Name="BottleneckBorder" Style="{StaticResource Card}" Background="{DynamicResource ChipBackgroundBrush}" Padding="12,8" Margin="0,0,0,14">
                                <DockPanel>
                                    <TextBlock Text="ДЕТЕКТОР ШИНЫ:" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="BottleneckStatusText" Text="🚀 Прямой доступ к накопителям. Конвейер оптимизирован для максимальной пропускной способности шины PCIe/SATA."
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Прогресс-бар передачи -->
                            <ProgressBar x:Name="LiveTransferProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                         Margin="0,0,0,14" BorderThickness="0" Background="{DynamicResource ProgressTrackBrush}" Foreground="{DynamicResource AccentBrush}"/>

                            <!-- Аппаратный график скорости в реальном времени (Canvas) -->
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="График скорости в реальном времени (30 FPS)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="GraphMaxScaleText" Text="Шкала: 1000 МБ/с" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Border Background="#0D111A" CornerRadius="6" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                        <Canvas x:Name="LiveSpeedCanvas" Height="140" SizeChanged="LiveSpeedCanvas_SizeChanged"/>
                                    </Border>
                                </StackPanel>
                            </Border>


                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= 2.5 STORAGE CONTROL CENTER ================= -->
                <Grid x:Name="StorageView" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed">
                    <storage:StorageControlCenterView x:Name="StorageCenterControl"/>
                </Grid>

                <!-- ================= 3. ИНСТРУМЕНТЫ ================= -->
                <Grid x:Name="ToolsView" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed" Margin="18">
                    <ScrollViewer x:Name="ToolsScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Center">
                            <!-- Windows Explorer Replacement Card -->
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🗂" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="ToolsExplorerBadge" CornerRadius="8" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource ChipBackgroundBrush}">
                                            <TextBlock x:Name="ToolsExplorerBadgeText" Text="Стандартный Windows Explorer" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Border>
                                        <Button x:Name="ToolsToggleExplorerBtn" Style="{StaticResource CyberButton}" Content="⚡ Сделать основным" Padding="14,6" Click="ToolsToggleExplorer_Click"/>
                                        <Button x:Name="ToolsRestoreExplorerBtn" Style="{StaticResource CyberToolButton}" Content="↺ Вернуть проводник" Margin="8,0,0,0" Padding="12,6" Click="ToolsRestoreExplorer_Click"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Замена стандартного Проводника Windows" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Перехват открытия папок и локальных дисков в Motion Commander с возможностью мгновенного отката" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Download Manager -->
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="⬇" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="Менеджер загрузок" Padding="14,6" Click="OpenDownloadManager_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Менеджер загрузок (Download Engine)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Интеллектуальный многопоточный менеджер загрузок с поддержкой докачки, расписания и Torrent" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Uninstaller -->
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🗑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="Удаление программ" Padding="14,6" Click="OpenUninstaller_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Менеджер установленных программ (Uninstaller)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Анализ, безопасное и принудительное удаление установленных приложений с защитой системных компонентов" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- WizTree Disk Analyzer -->
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🌳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="⚡ Запустить WizTree" Padding="14,6" Click="OpenWizTree_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Анализатор дискового пространства WizTree" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Визуальная карта весов директорий, топ-100 тяжелых файлов, диаграмма расширений и быстрые действия очистки" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Duplicate File Finder -->
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="Найти дубликаты" Padding="14,6" Click="OpenDuplicateFinder_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Поиск и безопасная очистка дубликатов файлов" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="3-этапное сканирование (Размер → Пре-хэш 4 КБ → Полный SHA-256), авто-выделение копий и безопасное удаление" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Driver Inspector -->
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🧩" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="Проверить драйверы" Padding="14,6" Click="OpenDriverInspector_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Инспектор системных драйверов и оборудования" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Диагностика накопителей NVMe/SATA, видеокарт, сетевых карт, выявление кодов ошибок и экспорт отчетов" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Хэши и контрольные суммы -->
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                                <DockPanel>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="#" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="Открыть калькулятор" Padding="14,6" Click="OpenChecksumTool_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Калькулятор контрольных сумм и проверка хэшей" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Мгновенный расчёт CRC32, MD5, SHA-1, SHA-256, SHA-512 в один потоковый проход и проверка совпадения" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Сравнение файлов -->
                            <Border Style="{StaticResource Card}" Padding="18">
                                <DockPanel>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="⇄" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="Сравнить файлы" Padding="14,6" Click="OpenFileCompare_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Побайтовое бинарное сравнение файлов" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Выявление различий между файлами любого размера с фиксацией смещения первого несовпадения" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= 4. UNINSTALLER VIEW ================= -->
                <Grid x:Name="UninstallerViewContainer" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed">
                    <DockPanel>
                        <!-- Back button panel -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⬅ Назад в инструменты" Style="{StaticResource CyberToolButton}" Padding="10,4" Click="CloseUninstaller_Click"/>
                            </StackPanel>
                        </Border>
                        
                        <uninstaller:UninstallerView x:Name="UninstallerControl"/>
                    </DockPanel>
                </Grid>

                <!-- ================= 4.5 DOWNLOAD MANAGER VIEW ================= -->
                <Grid x:Name="DownloadManagerViewContainer" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed">
                    <DockPanel>
                        <!-- Back button panel -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⬅ Назад в инструменты" Style="{StaticResource CyberToolButton}" Padding="10,4" Click="CloseDownloadManager_Click"/>
                            </StackPanel>
                        </Border>
                        
                        <dm:DownloadManagerView x:Name="DownloadManagerControl"/>
                    </DockPanel>
                </Grid>

                <!-- ================= 5. ДИАГНОСТИКА И БЕНЧМАРК ================= -->
                <!-- ================= 5. ДИАГНОСТИКА И БЕНЧМАРК ================= -->
                <Grid x:Name="DiagnosticsView" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed" Margin="14,6,14,10">
                    <Grid.Resources>
                        <Style x:Key="DiagSubTab" TargetType="RadioButton">
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6"
                                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="2,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ChipBackgroundBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ChipBackgroundBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Подвкладки управления -->
                        <RowDefinition Height="*"/>    <!-- Рабочая область -->
                    </Grid.RowDefinitions>

                    <!-- НАВИГАЦИОННАЯ ПАНЕЛЬ ПОДРАЗДЕЛОВ ДИАГНОСТИКИ -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DiagTabMonitoringRadio" GroupName="DiagSubGroup" Content="📈 Мониторинг &amp; Графики" Style="{StaticResource DiagSubTab}" IsChecked="True" Checked="DiagSubTab_Checked"/>
                                <RadioButton x:Name="DiagTabBottleneckRadio" GroupName="DiagSubGroup" Content="🔍 Поиск узких мест" Style="{StaticResource DiagSubTab}" Checked="DiagSubTab_Checked"/>
                                <RadioButton x:Name="DiagTabRecommendationsRadio" GroupName="DiagSubGroup" Content="💡 Умные рекомендации" Style="{StaticResource DiagSubTab}" Checked="DiagSubTab_Checked"/>
                                <RadioButton x:Name="DiagTabCompareRadio" GroupName="DiagSubGroup" Content="🖴 Сравнение накопителей" Style="{StaticResource DiagSubTab}" Checked="DiagSubTab_Checked"/>
                                <RadioButton x:Name="DiagTabProfilesRadio" GroupName="DiagSubGroup" Content="🎛 Профили &amp; Безопасность" Style="{StaticResource DiagSubTab}" Checked="DiagSubTab_Checked"/>
                                <RadioButton x:Name="DiagTabProcessesRadio" GroupName="DiagSubGroup" Content="⚡ Нагрузка &amp; Автозагрузка" Style="{StaticResource DiagSubTab}" Checked="DiagSubTab_Checked"/>
                                <RadioButton x:Name="DiagTabBenchmarkRadio" GroupName="DiagSubGroup" Content="🏎 Бенчмарк-комплекс" Style="{StaticResource DiagSubTab}" Checked="DiagSubTab_Checked"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- РАБОЧАЯ ОБЛАСТЬ ПОДРАЗДЕЛОВ -->
                    <Grid Grid.Row="1">

                        <!-- 1. МОНИТОРИНГ В ДИНАМИКЕ И ГРАФИКИ -->
                        <ScrollViewer x:Name="ViewDiagMonitoring" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Живые карточки метрик с историей -->
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <!-- CPU Card -->
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,5,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Процессор (CPU)" FontSize="11" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="DiagLiveCpuPercentText" Text="0%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock x:Name="DiagLiveCpuNameText" Text="Загрузка процессора" FontSize="10.5" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                            <!-- Мини-график истории CPU -->
                                            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="4" Height="65" Margin="0,0,0,6">
                                                <Canvas x:Name="DiagCpuCanvas" ClipToBounds="True"/>
                                            </Border>
                                            <DockPanel>
                                                <TextBlock x:Name="DiagLiveCpuCoresText" Text="Потоков: —" FontSize="9.5" Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="DiagLiveCpuAvgText" Text="Среднее: —" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- RAM Card -->
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="3,0,3,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Оперативная память (RAM)" FontSize="11" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="DiagLiveRamPercentText" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock x:Name="DiagLiveRamUsageText" Text="0 ГБ из 0 ГБ" FontSize="10.5" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                            <!-- Мини-график истории RAM -->
                                            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="4" Height="65" Margin="0,0,0,6">
                                                <Canvas x:Name="DiagRamCanvas" ClipToBounds="True"/>
                                            </Border>
                                            <DockPanel>
                                                <TextBlock x:Name="DiagLiveRamAvailText" Text="Свободно: —" FontSize="9.5" Style="{StaticResource MutedText}"/>
                                                <TextBlock Text="Физическая память" FontSize="9.5" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Disk Throughput Card -->
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="5,0,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="Накопители (I/O Throughput)" FontSize="11" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="DiagLiveDiskSpeedText" Text="0 МБ/с" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock x:Name="DiagLiveDiskSplitText" Text="Чтение: 0 МБ/с • Запись: 0 МБ/с" FontSize="10.5" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                            <!-- Мини-график истории Disk -->
                                            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="4" Height="65" Margin="0,0,0,6">
                                                <Canvas x:Name="DiagDiskCanvas" ClipToBounds="True"/>
                                            </Border>
                                            <DockPanel>
                                                <TextBlock x:Name="DiagLiveDiskActiveText" Text="Активность: 0%" FontSize="9.5" Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="DiagLiveDiskTempText" Text="Температура: н/д" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Блок «Сравнение: ДО и ПОСЛЕ изменений» (Baseline Comparison) -->
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <Button x:Name="DiagSetBaselineBtn" Style="{StaticResource CyberButton}" Content="📌 Зафиксировать «Снимок ДО»" Padding="12,5" Margin="0,0,6,0" Click="DiagSetBaseline_Click"/>
                                                <Button x:Name="DiagClearBaselineBtn" Style="{StaticResource CyberToolButton}" Content="✕ Сбросить" Padding="10,5" Click="DiagClearBaseline_Click"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Сравнение показателей: ДО и ПОСЛЕ изменений" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Зафиксируйте контрольную точку, примените профиль или твик, и сравните эффект." FontSize="10" Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Border x:Name="DiagBaselineActiveBadge" Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Delta CPU -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Дельта CPU" FontSize="9.5" Style="{StaticResource MutedText}"/>
                                                    <TextBlock x:Name="DiagDeltaCpuText" Text="Снимок не зафиксирован" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <!-- Delta RAM -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Дельта RAM" FontSize="9.5" Style="{StaticResource MutedText}"/>
                                                    <TextBlock x:Name="DiagDeltaRamText" Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <!-- Delta Disk -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Скорость диска" FontSize="9.5" Style="{StaticResource MutedText}"/>
                                                    <TextBlock x:Name="DiagDeltaDiskText" Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <!-- Delta Temp -->
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="Температура ядра" FontSize="9.5" Style="{StaticResource MutedText}"/>
                                                    <TextBlock x:Name="DiagDeltaTempText" Text="—" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 2. ПОИСК УЗКИХ МЕСТ (CONTEXT-AWARE BOTTLENECK DETECTOR) -->
                        <ScrollViewer x:Name="ViewDiagBottleneck" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Контекст активности пользователя -->
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Текущая задача:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="DiagContextCombo" Width="200" SelectionChanged="DiagContextCombo_SelectionChanged">
                                                <ComboBoxItem Content="⚡ Автоопределение (Auto)" IsSelected="True"/>
                                                <ComboBoxItem Content="🎮 Игры и 3D-графика"/>
                                                <ComboBoxItem Content="📁 Копирование файлов / I/O"/>
                                                <ComboBoxItem Content="🏎 Бенчмарк / Стресс-тест"/>
                                                <ComboBoxItem Content="☕ Офис, веб и покой"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Контекстный анализатор узких мест" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Анализ учитывает реальный профиль нагрузки: игровой рендер, дисковый поток или простой." FontSize="10" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Карточка диагноза Bottleneck -->
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                            <DockPanel>
                                                <Border x:Name="BottleneckBadgeBorder" DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24" Background="#10B981" Margin="0,0,14,0">
                                                    <TextBlock x:Name="BottleneckBadgeIcon" Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock x:Name="BottleneckTitle" Text="Максимальный сбалансированный поток" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <Border x:Name="BottleneckStatusPill" Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                            <TextBlock x:Name="DiagBottleneckStatusText" Text="Оптимально" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock x:Name="BottleneckDesc" Text="Шина ввода/вывода, память и процессор работают синхронно без задержек." FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                                    <TextBlock x:Name="BottleneckRec" Text="Рекомендация: конфигурация оптимальна, вмешательства не требуются." FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- На каких данных основан вывод -->
                                        <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="📊 Обоснование вердикта (на каких измерениях основан вывод):" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="BottleneckDataBasisText" Text="Сбор телеметрии..." FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="BottleneckMissingWarningText" Text="" FontSize="9.5" Foreground="#F59E0B" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 3. УМНЫЕ РЕКОМЕНДАЦИИ С ОБЪЯСНЕНИЕМ -->
                        <ScrollViewer x:Name="ViewDiagRecommendations" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Style="{StaticResource CyberToolButton}" Content="🔄 Обновить аудит" Padding="10,5" Click="DiagRefreshRecommendations_Click"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Рекомендации экспертной оптимизации с объяснением" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Что проверить, почему это поможет, ожидаемый измеримый эффект и оценка безопасности." FontSize="10" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Список подробных рекомендаций -->
                                <ItemsControl x:Name="DiagRecommendationsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <!-- Верхняя строка карточки: заголовок, категория, бейдж риска -->
                                                    <DockPanel Margin="0,0,0,8">
                                                        <Border Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{Binding RiskBadgeColor}" BorderThickness="1" CornerRadius="6" Padding="8,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RiskBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding RiskBadgeColor}"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SeverityIcon}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                    <!-- Детальные блоки: Что проверить, Почему поможет, Ожидаемый эффект -->
                                                    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="🔍 Что проверить:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding WhatToCheck}" FontSize="10" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,6"/>

                                                            <TextBlock Text="⚙ Почему это поможет:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding WhyItHelps}" FontSize="10" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,6"/>

                                                            <TextBlock Text="📈 Ожидаемый эффект:" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                                            <TextBlock Text="{Binding ExpectedEffect}" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,6"/>

                                                            <TextBlock Text="🎯 Достоверность вывода:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding ConfidenceText}" FontSize="10" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,1,0,6"/>

                                                            <TextBlock Text="⚡ Что именно изменится в системе:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Text="{Binding ExactSystemChanges}" FontSize="9.5" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,1,0,6"/>

                                                            <TextBlock Text="🛡 Оценка безопасности:" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                                            <TextBlock Text="{Binding RiskExplanation}" FontSize="9.5" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Основание вывода и кнопка действия -->
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="{Binding ActionText}" Padding="14,6" Tag="{Binding}" Click="DiagRecommendationAction_Click"/>
                                                        <TextBlock Text="{Binding DataBasis, StringFormat='📊 {0}'}" FontSize="9" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 4. СРАВНЕНИЕ НАКОПИТЕЛЕЙ (DRIVE COMPARISON & DISAMBIGUATION) -->
                        <ScrollViewer x:Name="ViewDiagCompare" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Инструмент прямого сравнения двух дисков бок-о-бок -->
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Инструмент точного сравнения накопителей (Side-by-Side Comparison)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Позволяет различить накопители с одинаковой моделью и ёмкостью по букве, разделу, шине и серийному номеру." FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

                                        <!-- Селекторы двух дисков -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Накопитель A:" FontSize="10.5" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="DiagCompareACombo" SelectionChanged="DiagCompareCombo_SelectionChanged"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="VS" FontWeight="Black" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,0"/>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Накопитель B:" FontSize="10.5" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="DiagCompareBCombo" SelectionChanged="DiagCompareCombo_SelectionChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Карточки сравнения параметров -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Панель Накопителя A -->
                                            <Border Grid.Column="0" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <StackPanel x:Name="DiagCompareAPanel">
                                                    <TextBlock x:Name="DiagCompAName" Text="Выберите накопитель A" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="DiagCompALetters" Text="Тома: —" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,2"/>
                                                    <TextBlock x:Name="DiagCompAId" Text="Идентификатор: —" FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="DiagCompASize" Text="Емкость: —" FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="DiagCompABus" Text="Интерфейс шины: —" FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="DiagCompAPart" Text="Схема разметки: —" FontSize="10" Style="{StaticResource MutedText}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Панель Накопителя B -->
                                            <Border Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <StackPanel x:Name="DiagCompareBPanel">
                                                    <TextBlock x:Name="DiagCompBName" Text="Выберите накопитель B" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="DiagCompBLetters" Text="Тома: —" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,2"/>
                                                    <TextBlock x:Name="DiagCompBId" Text="Идентификатор: —" FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="DiagCompBSize" Text="Емкость: —" FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="DiagCompBBus" Text="Интерфейс шины: —" FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="DiagCompBPart" Text="Схема разметки: —" FontSize="10" Style="{StaticResource MutedText}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Полный список накопителей с уникальной идентификацией -->
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Обнаруженные физические накопители системы" FontSize="12" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="DiagDisksList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <!-- Правый бейдж: тип носителя -->
                                                            <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MediaTypeString}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            </Border>

                                                            <!-- Левый бейдж: Буквы томов -->
                                                            <Border DockPanel.Dock="Left" Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DriveLettersFormatted}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource AccentBrush}"/>
                                                            </Border>

                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Model}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding SizeFormatted, StringFormat=' ({0})'}" FontSize="11" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding HardwareIdentity}" FontSize="10" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 5. ПРОФИЛИ ЗАДАЧ И БЕЗОПАСНОСТЬ (PROFILES & ROLLBACK) -->
                        <ScrollViewer x:Name="ViewDiagProfiles" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Панель доверия и отката -->
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button x:Name="DiagRollbackBtn" Style="{StaticResource CyberButton}" Content="⮌ ВОССТАНОВИТЬ ИСХОДНЫЕ НАСТРОЙКИ (Откат)" Padding="14,8" FontWeight="Bold" Click="DiagRollbackProfile_Click"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Безопасность и доверие: 1-клик откат и аудит" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Перед применением любого твика создается снимок параметров. В любой момент можно вернуть стандартное состояние." FontSize="10" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Карточки профилей задач -->
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <!-- Профиль 1: Игры -->
                                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,6,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="🎮 Игры и минимальная задержка" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <Button Style="{StaticResource CyberButton}" Content="Применить" Padding="10,4" HorizontalAlignment="Right" Click="DiagApplyGamingProfile_Click"/>
                                            </DockPanel>
                                            <TextBlock Text="Приоритет FPS и устранение микрофризов I/O" FontSize="10.5" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                            <TextBlock Text="• Схема питания: Высокая производительность Windows&#x0a;• Отключение парковки ядер CPU и задержек пробуждения&#x0a;• Понижение фонового приоритета служб Windows Search&#x0a;• Очистка SLC-кэша SSD перед запуском" FontSize="10" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="Ожидаемый эффект: устранение просадок 1% low FPS, плавная загрузка текстур." FontSize="9.5" Foreground="#10B981" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Профиль 2: Тихая работа -->
                                    <Border Style="{StaticResource Card}" Padding="16" Margin="6,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="🍃 Тихая работа и тишина СО" FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                                                <Button Style="{StaticResource CyberButton}" Content="Применить" Padding="10,4" HorizontalAlignment="Right" Click="DiagApplyQuietProfile_Click"/>
                                            </DockPanel>
                                            <TextBlock Text="Энергосбережение и минимальный нагрев" FontSize="10.5" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                            <TextBlock Text="• Схема питания: Энергосбережение (Power Saver)&#x0a;• Ограничение пикового тепловыделения ядер процессора&#x0a;• Щадящий режим для вентиляторов охлаждения&#x0a;• Таймаут отключения механических дисков при простое" FontSize="10" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="Ожидаемый эффект: снижение температуры на 6-12 °C, тихая работа вентиляторов." FontSize="9.5" Foreground="#10B981" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Профиль 3: Копирование файлов -->
                                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,6,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="🚀 Копирование файлов и I/O" FontSize="13" FontWeight="Bold" Foreground="#F59E0B"/>
                                                <Button Style="{StaticResource CyberButton}" Content="Применить" Padding="10,4" HorizontalAlignment="Right" Click="DiagApplyTransferProfile_Click"/>
                                            </DockPanel>
                                            <TextBlock Text="Максимальная линейная пропускная способность" FontSize="10.5" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                            <TextBlock Text="• Схема питания: Высокая производительность&#x0a;• Вызов Optimize-Volume ReTrim для очистки SLC-буфера&#x0a;• Direct I/O буфер в Motion Commander (до 4 МБ)&#x0a;• Повышенный приоритет дисковой очереди для операций" FontSize="10" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="Ожидаемый эффект: прирост линейной скорости на 15–35%, стабильный поток без задержек." FontSize="9.5" Foreground="#10B981" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Профиль 4: Сбалансированный -->
                                    <Border Style="{StaticResource Card}" Padding="16" Margin="6,0,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="⚖ Сбалансированный (Windows)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <Button Style="{StaticResource CyberToolButton}" Content="Применить" Padding="10,4" HorizontalAlignment="Right" Click="DiagApplyBalancedProfile_Click"/>
                                            </DockPanel>
                                            <TextBlock Text="Штатный режим Windows 11 по умолчанию" FontSize="10.5" FontWeight="SemiBold" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                            <TextBlock Text="• Схема питания: Сбалансированная (Balanced)&#x0a;• Автоматическое динамическое управление тактовой частотой&#x0a;• Стандартное распределение приоритетов Windows" FontSize="10" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="Ожидаемый эффект: стандартное поведение системы без специальных твиков." FontSize="9.5" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Журнал аудита действий -->
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button Style="{StaticResource CyberToolButton}" Content="🔄 Обновить журнал" Padding="10,4" DockPanel.Dock="Right" Click="DiagRefreshAudit_Click"/>
                                            <TextBlock Text="📜 Журнал аудита действий (Audit Log)" FontSize="12" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                        </DockPanel>
                                        <TextBox x:Name="DiagAuditLogText" Height="100" FontFamily="Consolas" FontSize="10.5" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Padding="8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 6. ФОНОВАЯ НАГРУЗКА И АВТОЗАГРУЗКА (PROCESSES & STARTUP) -->
                        <ScrollViewer x:Name="ViewDiagProcesses" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Верхняя панель со ссылками на штатные утилиты Windows -->
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource CyberButton}" Content="⚙ Автозагрузка Windows" Padding="12,6" Margin="0,0,6,0" Click="DiagOpenStartupSettings_Click"/>
                                            <Button Style="{StaticResource CyberToolButton}" Content="📊 Диспетчер задач" Padding="10,6" Margin="0,0,6,0" Click="DiagOpenTaskMgr_Click"/>
                                            <Button Style="{StaticResource CyberToolButton}" Content="🛠 Службы" Padding="10,6" Click="DiagOpenServices_Click"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Контроль автозагрузки и фоновой нагрузки" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Список ресурсоёмких процессов с понятным описанием и быстрый переход в системные настройки." FontSize="10" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Левая колонка: Ресурсоёмкие процессы -->
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button Style="{StaticResource CyberToolButton}" Content="🔄" Width="26" Height="26" Padding="0" DockPanel.Dock="Right" Click="DiagRefreshProcesses_Click"/>
                                                <TextBlock Text="Топ процессов по памяти и нагрузке" FontSize="12" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                            </DockPanel>
                                            <ItemsControl x:Name="DiagProcessesList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding MemoryFormatted}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name, StringFormat='{}{0}.exe'}" FontWeight="SemiBold" FontSize="11"/>
                                                                    <TextBlock Text="{Binding FriendlyDescription}" FontSize="9.5" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Правая колонка: Программы в автозагрузке -->
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button Style="{StaticResource CyberToolButton}" Content="🔄" Width="26" Height="26" Padding="0" DockPanel.Dock="Right" Click="DiagRefreshProcesses_Click"/>
                                                <TextBlock Text="Программы в автозагрузке Windows" FontSize="12" FontWeight="Bold" Style="{StaticResource MutedText}"/>
                                            </DockPanel>
                                            <ItemsControl x:Name="DiagStartupList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                                            <DockPanel>
                                                                <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="4" Padding="6,1" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ImpactRating}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding ImpactColor}"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Scope}" FontSize="9.5" Style="{StaticResource MutedText}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 7. АППАРАТНЫЙ БЕНЧМАРК-КОМПЛЕКС -->
                        <ScrollViewer x:Name="ViewDiagBenchmark" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Карточка запуска бенчмарка с предупреждением -->
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Аппаратный бенчмарк-комплекс (Benchmark Engine)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Комплексный замер: линейная запись, чтение, потоковое копирование, мелкие файлы (IOPS) и сжатие." FontSize="10.5" Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                            <Button x:Name="RunBenchBtn" Grid.Column="1" Style="{StaticResource CyberButton}" Content="🚀 Запустить бенчмарк" Height="36" Padding="16,0" Click="RunBenchmark_Click"/>
                                        </Grid>

                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Целевой накопитель для тестирования:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="BenchTargetCombo" Height="26" VerticalContentAlignment="Center" Width="220" HorizontalAlignment="Left"/>
                                        </DockPanel>

                                        <!-- Предупреждение перед тестом -->
                                        <Border Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="⚠ Условия тестирования и безопасность накопителя:" FontSize="10.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                                <TextBlock Text="• Будет записан временный тестовый файл размером до 500 МБ в выбранном томе.&#x0a;• Накопитель будет кратковременно загружен на 100% операциями чтения и записи.&#x0a;• Ориентировочное время теста: 15–30 секунд.&#x0a;• Все временные файлы удаляются автоматически сразу после завершения тестирования." FontSize="10" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <ProgressBar x:Name="BenchProgress" Height="6" Margin="0,10,0,4" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                        <TextBlock x:Name="BenchStatusText" Text="" FontSize="11" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>

                                        <ListView x:Name="BenchResultsList" BorderThickness="0" Background="Transparent" Visibility="Collapsed">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Тест" Width="240" DisplayMemberBinding="{Binding TestName}"/>
                                                    <GridViewColumn Header="Категория" Width="130" DisplayMemberBinding="{Binding Category}"/>
                                                    <GridViewColumn Header="Скорость" Width="110">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding ThroughputMBps, StringFormat='{}{0:F1} МБ/с'}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="IOPS" Width="80" DisplayMemberBinding="{Binding Iops}"/>
                                                    <GridViewColumn Header="Задержка" Width="90" DisplayMemberBinding="{Binding AverageLatencyMs, StringFormat='{}{0:F1} мс'}"/>
                                                    <GridViewColumn Header="Результат" Width="220" DisplayMemberBinding="{Binding SummaryText}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Grid>

            <!-- FOOTER & COMMANDER FUNCTION KEYS -->
            <Border Grid.Row="3" Background="{DynamicResource LiquidGlassMaterialLevel1Brush}" BorderBrush="{DynamicResource LiquidGlassSubtleBorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <!-- Панель функциональных клавиш Commander (F3-F8) -->
                    <Border x:Name="CommanderFnBar" DockPanel.Dock="Top" Background="{DynamicResource LiquidGlassMaterialLevel2Brush}"
                            BorderBrush="{DynamicResource LiquidGlassSubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
                        <UniformGrid Columns="6" Rows="1">
                            <Button Style="{StaticResource CommanderFnButton}" Click="CmdF3_Click" ToolTip="Просмотр выбранного файла (F3)">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run Text="F3" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/> <Run Text="Просмотр"/>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource CommanderFnButton}" Click="CmdF4_Click" ToolTip="Правка в текстовом редакторе (F4)">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run Text="F4" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/> <Run Text="Правка"/>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource CommanderFnButton}" Click="CmdF5_Click" ToolTip="Копировать в папку / обновить (F5)">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run Text="F5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/> <Run Text="Копия"/>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource CommanderFnButton}" Click="CmdF6_Click" ToolTip="Переместить в папку (F6)">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run Text="F6" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/> <Run Text="Перенос"/>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource CommanderFnButton}" Click="CmdF7_Click" ToolTip="Создать новую папку (F7 / Ctrl+Shift+N)">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run Text="F7" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/> <Run Text="Папка"/>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource CommanderFnButton}" Click="CmdF8_Click" ToolTip="Удалить выбранное (F8 / Del)">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Run Text="F8" FontWeight="Bold" Foreground="#EF4444"/> <Run Text="Удалить"/>
                                </TextBlock>
                            </Button>
                        </UniformGrid>
                    </Border>
                    <!-- Статус-бар внизу -->
                    <Border Background="Transparent" Padding="12,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusFilesText" FontSize="11" Style="{StaticResource MutedText}" Text="0 элементов"/>
                            <TextBlock x:Name="StatusDiskText" Grid.Column="1" FontSize="11" Style="{StaticResource MutedText}" Text=""/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
            
            <!-- SEAMLESS UPDATE MORPHING OVERLAY -->
            <Grid x:Name="MorphingOverlay" Grid.RowSpan="4" Visibility="Collapsed">
                <Border Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.85">
                    <Border.Effect>
                        <BlurEffect Radius="30"/>
                    </Border.Effect>
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="80" Height="80" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="MorphingSpinnerTransform" Angle="0"/>
                        </Grid.RenderTransform>
                        <Ellipse Stroke="{DynamicResource SubtleBorderBrush}" StrokeThickness="4"/>
                        <Path Data="M 40,0 A 40,40 0 0,1 80,40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Text="Завершение обновления..." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Бесшовный переход..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
