<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= MOTION & ANIMATION TOKENS ================= -->
    <Duration x:Key="AnimationDurationFast">0:0:0.100</Duration>
    <Duration x:Key="AnimationDurationNormal">0:0:0.140</Duration>
    <Duration x:Key="AnimationDurationPanel">0:0:0.200</Duration>
    <Duration x:Key="AnimationDurationPopup">0:0:0.160</Duration>

    <!-- Standard Easing Functions -->
    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut"/>
    <QuadraticEase x:Key="EaseOutQuad" EasingMode="EaseOut"/>

</ResourceDictionary>
