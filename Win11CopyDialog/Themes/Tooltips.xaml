<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         MOTION COMMANDER — LIQUID GLASS TOOLTIP SYSTEM (Tooltips.xaml)
         ========================================================================= -->

    <Style x:Key="GlassToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
        <Setter Property="FontFamily" Value="{DynamicResource BaseFontFamily}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{DynamicResource LiquidGlassMaterialLevel5Brush}"
                            BorderBrush="{DynamicResource LiquidGlassBorderLevel4Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusM}"
                            Padding="8,5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="3"
                                              Direction="270"
                                              Color="#000000"
                                              Opacity="0.55"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource GlassToolTip}"/>

</ResourceDictionary>
