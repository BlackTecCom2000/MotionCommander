<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!--            3D LIQUID GLASS REFLECTIVE & BEVEL GRADIENTS           -->
    <!-- ================================================================= -->

    <!-- 45-degree Specular Reflection Sheen (mimics .box:after diagonal glare) -->
    <LinearGradientBrush x:Key="LiquidGlassSheenDiagonal" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#55FFFFFF" Offset="0.0"/>
        <GradientStop Color="#18FFFFFF" Offset="0.18"/>
        <GradientStop Color="Transparent" Offset="0.35"/>
        <GradientStop Color="Transparent" Offset="0.68"/>
        <GradientStop Color="#10FFFFFF" Offset="0.85"/>
        <GradientStop Color="#38FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Inset Specular Bevel Highlight (mimics multi-tier inset box-shadow) -->
    <LinearGradientBrush x:Key="LiquidGlassBevelHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#75FFFFFF" Offset="0.0"/>
        <GradientStop Color="#22FFFFFF" Offset="0.28"/>
        <GradientStop Color="#06FFFFFF" Offset="0.75"/>
        <GradientStop Color="#28FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Accent Inset Specular Bevel Highlight (Cyan Glow) -->
    <LinearGradientBrush x:Key="LiquidGlassAccentBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C0FFFFFF" Offset="0.0"/>
        <GradientStop Color="#5500D4FF" Offset="0.3"/>
        <GradientStop Color="#1500D4FF" Offset="0.7"/>
        <GradientStop Color="#6000D4FF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Danger Inset Specular Bevel Highlight (Ruby Glow) -->
    <LinearGradientBrush x:Key="LiquidGlassDangerBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0FFA0B0" Offset="0.0"/>
        <GradientStop Color="#50FF4567" Offset="0.3"/>
        <GradientStop Color="#15FF4567" Offset="0.7"/>
        <GradientStop Color="#60FF4567" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ================================================================= -->
    <!--                   1. BASE 3D LIQUID GLASS BUTTON                  -->
    <!-- ================================================================= -->

    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeightNormal}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingControlInner}"/>
        <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilySystem}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Ambient Depth Drop Shadow -->
                        <Border x:Name="ShadowHost"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2.5" Direction="270"
                                                  Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.32"/>
                            </Border.Effect>
                        </Border>

                        <!-- Dark Depth Core Refraction (:before equivalent) -->
                        <Border x:Name="DepthCore"
                                Margin="1"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                Background="#12000000"
                                IsHitTestVisible="False"/>

                        <!-- Base Glass Body & Outer Rim Double Border -->
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                SnapsToDevicePixels="True"/>

                        <!-- Concentric Inset Specular Bevel Border (inset highlights) -->
                        <Border x:Name="InnerBevel"
                                Margin="1"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource LiquidGlassBevelHighlight}"
                                IsHitTestVisible="False"
                                Opacity="0.85"/>

                        <!-- 45° Specular Reflection Sheen (:after equivalent) -->
                        <Border x:Name="SpecularSheen"
                                Margin="1"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                Background="{StaticResource LiquidGlassSheenDiagonal}"
                                IsHitTestVisible="False"
                                Opacity="0.35"/>

                        <!-- Content Presenter -->
                        <ContentPresenter x:Name="ContentSite"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Optical Lift & Sheen Flare -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderStrong}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270"
                                                      Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                                        <TranslateTransform X="0" Y="-1.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Pressed: Tactile Compression & Optical Depression -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                                      Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================= -->
    <!--              2. 3D LIQUID GLASS PRIMARY (ACCENT GLOW)             -->
    <!-- ================================================================= -->

    <Style x:Key="GlassPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Dual Ambient Shadow + Accent Glow -->
                        <Border x:Name="ShadowHost"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                  Color="{DynamicResource GlowAccentColor}" Opacity="0.55"/>
                            </Border.Effect>
                        </Border>

                        <!-- Dark Depth Core Refraction -->
                        <Border x:Name="DepthCore"
                                Margin="1"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                Background="#1A000000"
                                IsHitTestVisible="False"/>

                        <!-- Base Glass Accent Body -->
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                SnapsToDevicePixels="True"/>

                        <!-- Accent Specular Inset Bevel -->
                        <Border x:Name="InnerBevel"
                                Margin="1"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource LiquidGlassAccentBevel}"
                                IsHitTestVisible="False"
                                Opacity="0.9"/>

                        <!-- 45° Specular Sheen -->
                        <Border x:Name="SpecularSheen"
                                Margin="1"
                                CornerRadius="{DynamicResource RadiusNormal}"
                                Background="{StaticResource LiquidGlassSheenDiagonal}"
                                IsHitTestVisible="False"
                                Opacity="0.45"/>

                        <!-- Content Presenter -->
                        <ContentPresenter x:Name="ContentSite"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Vibrant Luminescence -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                                      Color="{DynamicResource GlowAccentColor}" Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.015" ScaleY="1.015"/>
                                        <TranslateTransform X="0" Y="-1.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.25"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                      Color="{DynamicResource GlowAccentColor}" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================= -->
    <!--             3. SECONDARY, GHOST & DANGER GLASS BUTTONS            -->
    <!-- ================================================================= -->

    <Style x:Key="GlassSecondaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
    </Style>

    <Style x:Key="GlassGhostButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="GlassDangerButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="#30FF4567"/>
        <Setter Property="Foreground" Value="#FF4567"/>
        <Setter Property="BorderBrush" Value="#70FF4567"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Ruby Ambient Glow Shadow -->
                        <Border x:Name="ShadowHost" CornerRadius="{DynamicResource RadiusNormal}" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                                  Color="#FF4567" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DepthCore" Margin="1" CornerRadius="{DynamicResource RadiusNormal}"
                                Background="#1A000000" IsHitTestVisible="False"/>
                        <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusNormal}" SnapsToDevicePixels="True"/>
                        <Border x:Name="InnerBevel" Margin="1" CornerRadius="{DynamicResource RadiusNormal}"
                                BorderThickness="1" BorderBrush="{StaticResource LiquidGlassDangerBevel}"
                                IsHitTestVisible="False" Opacity="0.85"/>
                        <Border x:Name="SpecularSheen" Margin="1" CornerRadius="{DynamicResource RadiusNormal}"
                                Background="{StaticResource LiquidGlassSheenDiagonal}" IsHitTestVisible="False" Opacity="0.35"/>
                        <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="#50FF4567"/>
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#B0FF4567"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                                      Color="#FF4567" Opacity="0.75"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                                        <TranslateTransform X="0" Y="-1.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonRoot" Property="Background" Value="#70FF4567"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================= -->
    <!--             4. COMPACT GLASS ICON BUTTON (Square or Pill)         -->
    <!-- ================================================================= -->

    <Style x:Key="GlassIconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="{DynamicResource ControlHeightCompact}"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}"/>
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ShadowHost" CornerRadius="{DynamicResource RadiusNormal}" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270"
                                                  Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.25"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusNormal}" SnapsToDevicePixels="True"/>
                        <Border x:Name="InnerBevel" Margin="1" CornerRadius="{DynamicResource RadiusNormal}"
                                BorderThickness="1" BorderBrush="{StaticResource LiquidGlassBevelHighlight}"
                                IsHitTestVisible="False" Opacity="0.75"/>
                        <Border x:Name="SpecularSheen" Margin="1" CornerRadius="{DynamicResource RadiusNormal}"
                                Background="{StaticResource LiquidGlassSheenDiagonal}" IsHitTestVisible="False" Opacity="0.3"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorder}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.8"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                                      Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.45"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                        <TranslateTransform X="0" Y="-1"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================= -->
    <!--       5. TITLEBAR CAPTION BUTTONS (Settings, Theme, Min, Max, Close) -->
    <!-- ================================================================= -->

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid WindowChrome.IsHitTestVisibleInChrome="True" SnapsToDevicePixels="True">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1"
                                BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Border x:Name="Bevel" Margin="2" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{StaticResource LiquidGlassBevelHighlight}" Opacity="0"
                                IsHitTestVisible="False" WindowChrome.IsHitTestVisibleInChrome="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
                            <Setter TargetName="Bevel" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid WindowChrome.IsHitTestVisibleInChrome="True" SnapsToDevicePixels="True">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1"
                                BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Border x:Name="Bevel" Margin="2" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{StaticResource LiquidGlassDangerBevel}" Opacity="0"
                                IsHitTestVisible="False" WindowChrome.IsHitTestVisibleInChrome="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#C8E81123"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="#FFA0B0"/>
                            <Setter TargetName="Bevel" Property="Opacity" Value="0.9"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E8E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================= -->
    <!--          6. RIBBON ACTION BUTTON (COMMAND BAR DESKTOP DOCK)       -->
    <!-- ================================================================= -->

    <!-- Фирменная 3D Liquid Glass кнопка панели команд (RibbonActionButton) -->
    <Style x:Key="RibbonActionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassSubtleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilySystem}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <!-- 1. Ambient Depth Drop Shadow -->
                        <Border x:Name="ShadowHost" CornerRadius="8" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="7" ShadowDepth="2" Direction="270"
                                                  Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>

                        <!-- 2. Dark Depth Core Refraction (:before) -->
                        <Border x:Name="DepthCore" Margin="1" CornerRadius="8"
                                Background="#10000000" IsHitTestVisible="False"/>

                        <!-- 3. Base Glass Surface & Border -->
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"/>

                        <!-- 4. Concentric Inset Specular Bevel Highlight -->
                        <Border x:Name="InnerBevel" Margin="1" CornerRadius="7"
                                BorderThickness="1" BorderBrush="{StaticResource LiquidGlassBevelHighlight}"
                                IsHitTestVisible="False" Opacity="0.8"/>

                        <!-- 5. 45° Specular Reflection Sheen (:after) -->
                        <Border x:Name="SpecularSheen" Margin="1" CornerRadius="7"
                                Background="{StaticResource LiquidGlassSheenDiagonal}"
                                IsHitTestVisible="False" Opacity="0.32"/>

                        <!-- 6. Content Presenter -->
                        <ContentPresenter x:Name="ContentSite"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Tactile Lift & Glare Sheen Flare -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderStrong}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="11" ShadowDepth="3.5" Direction="270"
                                                      Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.015" ScaleY="1.015"/>
                                        <TranslateTransform X="0" Y="-1.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Pressed: Tactile Mechanical Compression -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                                      Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================= -->
    <!--       7. RIBBON PRIMARY ACTION BUTTON (ARCHIVE, FILE MANAGER)     -->
    <!-- ================================================================= -->

    <!-- Акцентная 3D Liquid Glass кнопка панели команд (RibbonPrimaryActionButton) -->
    <Style x:Key="RibbonPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource RibbonActionButton}">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassAccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Dual Ambient Shadow + Accent Glow -->
                        <Border x:Name="ShadowHost" CornerRadius="8" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                                  Color="{DynamicResource GlowAccentColor}" Opacity="0.55"/>
                            </Border.Effect>
                        </Border>

                        <!-- Dark Depth Core Refraction -->
                        <Border x:Name="DepthCore" Margin="1" CornerRadius="8"
                                Background="#1A000000" IsHitTestVisible="False"/>

                        <!-- Base Accent Glass Body -->
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"/>

                        <!-- Concentric Accent Specular Inset Bevel -->
                        <Border x:Name="InnerBevel" Margin="1" CornerRadius="7"
                                BorderThickness="1" BorderBrush="{StaticResource LiquidGlassAccentBevel}"
                                IsHitTestVisible="False" Opacity="0.9"/>

                        <!-- 45° Specular Sheen -->
                        <Border x:Name="SpecularSheen" Margin="1" CornerRadius="7"
                                Background="{StaticResource LiquidGlassSheenDiagonal}"
                                IsHitTestVisible="False" Opacity="0.45"/>

                        <!-- Content Presenter -->
                        <ContentPresenter x:Name="ContentSite"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Brilliant Accent Flare & Lift -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassAccentGlow}"/>
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3.5" Direction="270"
                                                      Color="{DynamicResource GlowAccentColor}" Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                        <TranslateTransform X="0" Y="-1.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassAccentGlow}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.25"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270"
                                                      Color="{DynamicResource GlowAccentColor}" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================= -->
    <!--       8. CIRCULAR 3D LIQUID GLASS BUTTON (REFRESH, NAV, BACK)     -->
    <!-- ================================================================= -->

    <!-- Круглая 3D кнопка навигации / действий (CyberNavCircleButton) -->
    <Style x:Key="CyberNavCircleButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassSubtleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Circular Ambient Shadow -->
                        <Border x:Name="ShadowHost" CornerRadius="16" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="7" ShadowDepth="2" Direction="270"
                                                  Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>

                        <!-- Circular Dark Core Refraction -->
                        <Border x:Name="DepthCore" Margin="1" CornerRadius="15"
                                Background="#10000000" IsHitTestVisible="False"/>

                        <!-- Circular Base Glass Body -->
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True"/>

                        <!-- Circular Concentric Inset Specular Bevel Highlight -->
                        <Border x:Name="InnerBevel" Margin="1" CornerRadius="15"
                                BorderThickness="1" BorderBrush="{StaticResource LiquidGlassBevelHighlight}"
                                IsHitTestVisible="False" Opacity="0.8"/>

                        <!-- 45° Circular Specular Sheen -->
                        <Border x:Name="SpecularSheen" Margin="1" CornerRadius="15"
                                Background="{StaticResource LiquidGlassSheenDiagonal}"
                                IsHitTestVisible="False" Opacity="0.35"/>

                        <!-- Centered Icon / Content -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Scale up disc & flare sheen -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderStrong}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270"
                                                      Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                        <TranslateTransform X="0" Y="-1"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270"
                                                      Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================================================================= -->
    <!--                 9. BACKWARD COMPATIBILITY ALIASES                 -->
    <!-- ================================================================= -->

    <Style x:Key="Win11Button" TargetType="Button" BasedOn="{StaticResource GlassButton}"/>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButton}"/>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GlassIconButton}"/>
    <Style x:Key="CyberButton" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButton}"/>
    <Style x:Key="CyberPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButton}"/>
    <Style x:Key="CyberDangerButton" TargetType="Button" BasedOn="{StaticResource GlassDangerButton}"/>
    <Style x:Key="CyberToolButton" TargetType="Button" BasedOn="{StaticResource GlassButton}"/>

</ResourceDictionary>
