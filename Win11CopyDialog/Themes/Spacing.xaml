<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= SPACING TOKENS (4px Baseline Grid) ================= -->
    <Thickness x:Key="Spacing4">4</Thickness>
    <Thickness x:Key="Spacing6">6</Thickness>
    <Thickness x:Key="Spacing8">8</Thickness>
    <Thickness x:Key="Spacing10">10</Thickness>
    <Thickness x:Key="Spacing12">12</Thickness>
    <Thickness x:Key="Spacing16">16</Thickness>
    <Thickness x:Key="Spacing20">20</Thickness>
    <Thickness x:Key="Spacing24">24</Thickness>
    <Thickness x:Key="Spacing32">32</Thickness>
    <Thickness x:Key="Spacing40">40</Thickness>
    <Thickness x:Key="Spacing48">48</Thickness>

    <!-- Component Padding Standards -->
    <Thickness x:Key="PaddingControlInner">10,5</Thickness>
    <Thickness x:Key="PaddingCommandInner">10,6</Thickness>
    <Thickness x:Key="PaddingInputInner">10,6</Thickness>
    <Thickness x:Key="PaddingCardInner">14,12</Thickness>
    <Thickness x:Key="PaddingDialogInner">20,16</Thickness>
    <Thickness x:Key="PaddingPillInner">14,6</Thickness>
    <Thickness x:Key="PaddingListItem">8,4</Thickness>
    <Thickness x:Key="PaddingGridCell">8,4</Thickness>

    <!-- Standard Margins -->
    <Thickness x:Key="MarginControlSmall">0,0,4,0</Thickness>
    <Thickness x:Key="MarginControlNormal">0,0,8,0</Thickness>
    <Thickness x:Key="MarginSectionBottom">0,0,0,12</Thickness>

</ResourceDictionary>
