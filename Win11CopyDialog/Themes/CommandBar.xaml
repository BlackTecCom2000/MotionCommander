<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= FLOATING LIQUID GLASS COMMAND BAR (Rules 6 & 11) ================= -->

    <!-- Unified Floating Glass Command Dock Container -->
    <Style x:Key="GlassCommandDock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="1.5" Direction="270"
                                  Color="#000000" Opacity="0.2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle Low-Opacity Command Bar Spacer (Rule 6: not a hard divider) -->
    <Style x:Key="GlassCommandSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Fill" Value="{StaticResource GlassBorderSubtle}"/>
        <Setter Property="Margin" Value="4,0,5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <!-- Glass Path & Search Bar Continuous Container (Rule 11) -->
    <Style x:Key="GlassAddressDock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
