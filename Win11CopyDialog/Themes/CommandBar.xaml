<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= FLOATING LIQUID GLASS COMMAND BAR ================= -->

    <!-- Glass Command Dock Container -->
    <Style x:Key="GlassCommandDock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorder}"/>
        <Setter Property="BorderThickness" Value="0,1,0,1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                  Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass Command Bar Separator -->
    <Style x:Key="GlassCommandSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Fill" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
        <Setter Property="Margin" Value="6,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Glass Path & Search Bar Container -->
    <Style x:Key="GlassAddressDock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
