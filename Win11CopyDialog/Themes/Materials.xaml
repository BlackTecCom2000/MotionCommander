<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================= LIQUID GLASS MATERIAL SYSTEM (Levels 0 - 6) ================= -->

    <!-- Level 0: Background (Deep near-black ambient radial surface) -->
    <SolidColorBrush x:Key="LiquidGlassBackground" Color="#050912"/>

    <!-- Level 1: Main Application Surface (85% Dark Translucent) -->
    <SolidColorBrush x:Key="LiquidGlassSurface" Color="#D90A1426"/>

    <!-- Level 2: Glass Panels (Sidebar, Inspector, Dock containers - 70% Translucent) -->
    <SolidColorBrush x:Key="LiquidGlassPanel" Color="#B2081222"/>

    <!-- Level 3: Elevated Glass Surfaces (Drive Cards, Properties - 78% Translucent) -->
    <SolidColorBrush x:Key="LiquidGlassSurfaceElevated" Color="#C80D192E"/>

    <!-- Level 4: Floating Glass Surfaces (Command Bar, Address Bar - 82% Translucent) -->
    <SolidColorBrush x:Key="LiquidGlassSurfaceFloating" Color="#D00F1E38"/>

    <!-- Level 5: Modal / Dialog Glass Surfaces (Context Menu, Dialogs, Popups - 92% Translucent) -->
    <SolidColorBrush x:Key="LiquidGlassSurfaceModal" Color="#EB0B1424"/>

    <!-- Level 6: Active / Focused Glass (Accent-tinted interactive highlights) -->
    <SolidColorBrush x:Key="LiquidGlassActiveHighlight" Color="#40168CFF"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="LiquidGlassBorderSubtle" Color="#1578BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassBorder" Color="#2E78BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassBorderStrong" Color="#4578BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassHighlight" Color="#30FFFFFF"/>

    <!-- Shadows -->
    <Color x:Key="LiquidGlassShadowColor">#80000000</Color>
    <Color x:Key="LiquidGlassGlowAccentColor">#40168CFF</Color>

    <!-- Blur & Opacity Constants -->
    <sys:Double x:Key="LiquidGlassBlurSmall">8</sys:Double>
    <sys:Double x:Key="LiquidGlassBlurMedium">16</sys:Double>
    <sys:Double x:Key="LiquidGlassBlurLarge">28</sys:Double>

    <sys:Double x:Key="LiquidGlassOpacityLow">0.25</sys:Double>
    <sys:Double x:Key="LiquidGlassOpacityMedium">0.65</sys:Double>
    <sys:Double x:Key="LiquidGlassOpacityHigh">0.88</sys:Double>

    <!-- Accents -->
    <SolidColorBrush x:Key="LiquidGlassAccentSoft" Color="#25168CFF"/>
    <SolidColorBrush x:Key="LiquidGlassAccentStrong" Color="#168CFF"/>

    <!-- Level 0 to 6 Brushes (Initial Design-Time Tokens) -->
    <SolidColorBrush x:Key="LiquidGlassMaterialLevel0Brush" Color="#050912"/>
    <SolidColorBrush x:Key="LiquidGlassMaterialLevel1Brush" Color="#D90A1426"/>
    <SolidColorBrush x:Key="LiquidGlassMaterialLevel2Brush" Color="#B2081222"/>
    <SolidColorBrush x:Key="LiquidGlassMaterialLevel3Brush" Color="#C80D192E"/>
    <SolidColorBrush x:Key="LiquidGlassMaterialLevel4Brush" Color="#D00F1E38"/>
    <SolidColorBrush x:Key="LiquidGlassMaterialLevel5Brush" Color="#EB0B1424"/>
    <SolidColorBrush x:Key="LiquidGlassMaterialLevel6Brush" Color="#40168CFF"/>

    <!-- Border Level Brushes -->
    <SolidColorBrush x:Key="LiquidGlassBorderLevel1Brush" Color="#1578BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassBorderLevel2Brush" Color="#2E78BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassBorderLevel3Brush" Color="#3878BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassBorderLevel4Brush" Color="#4578BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassBorderLevel5Brush" Color="#6078BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassSubtleBorderBrush" Color="#1578BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassHoverBorderBrush" Color="#168CFF"/>

    <!-- Control & Input Brushes -->
    <SolidColorBrush x:Key="LiquidGlassCardBorderBrush" Color="#2E78BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassCardBackgroundBrush" Color="#C80D192E"/>
    <SolidColorBrush x:Key="LiquidGlassInputBackgroundBrush" Color="#6008111F"/>
    <SolidColorBrush x:Key="LiquidGlassInputBorderBrush" Color="#2E78BEFF"/>
    <SolidColorBrush x:Key="LiquidGlassInputHoverBackgroundBrush" Color="#232936"/>
    <SolidColorBrush x:Key="LiquidGlassInputFocusedBorderBrush" Color="#168CFF"/>

    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#232936"/>
    <SolidColorBrush x:Key="ControlActiveBackgroundBrush" Color="#40168CFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#4D168CFF"/>
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#4094A3B8"/>
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#168CFF"/>

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#B2081222"/>

    <!-- ================= SEMANTIC BORDER SYSTEM (Rules 14 & 15) ================= -->
    <!-- GlassBorderInvisible: 0% opacity -->
    <SolidColorBrush x:Key="GlassBorderInvisible" Color="#00000000"/>
    <!-- GlassBorderSubtle: ~4% soft white edge (near-invisible material boundary) -->
    <SolidColorBrush x:Key="GlassBorderSubtle" Color="#0AFFFFFF"/>
    <!-- GlassBorderDefault: ~9% subtle blue-tinted material refraction -->
    <SolidColorBrush x:Key="GlassBorderDefault" Color="#1678BEFF"/>
    <!-- GlassBorderStrong: for focus, active selections, high elevation -->
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#3078BEFF"/>
    <!-- Top-edge specular glass highlight (soft ambient) -->
    <SolidColorBrush x:Key="GlassSpecularHighlight" Color="#20FFFFFF"/>

    <!-- ================= SEMANTIC SHADOW SYSTEM (Rule 16) ================= -->
    <DropShadowEffect x:Key="GlassShadowSmall" BlurRadius="16" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.30"/>
    <DropShadowEffect x:Key="GlassShadowMedium" BlurRadius="28" ShadowDepth="4" Direction="270"
                      Color="#000000" Opacity="0.40"/>
    <DropShadowEffect x:Key="GlassShadowLarge" BlurRadius="44" ShadowDepth="8" Direction="270"
                      Color="#000000" Opacity="0.55"/>

    <!-- ================= macOS & 2211 LIQUID GLASS CHROMATIC TOKENS ================= -->
    <SolidColorBrush x:Key="MacOsGlassCoreBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="MacOsGlassPerimeterGlow" Color="#1EFFFFFF"/>
    <LinearGradientBrush x:Key="MacOsLiquidGlassBevel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#30FFFFFF" Offset="0.0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.25"/>
        <GradientStop Color="#06FFFFFF" Offset="0.7"/>
        <GradientStop Color="#18FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Chromatic Lens Dispersion Border Brush (Whisper-soft refraction without harsh outlines) -->
    <LinearGradientBrush x:Key="LiquidGlassLensChromaticBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2200E5FF" Offset="0.0"/>  <!-- Soft Cyan Rim -->
        <GradientStop Color="#35FFFFFF" Offset="0.15"/> <!-- Diffuse Glare -->
        <GradientStop Color="#0E78BEFF" Offset="0.55"/>
        <GradientStop Color="#1C6366FF" Offset="0.85"/> <!-- Soft Violet Rim -->
        <GradientStop Color="#18F43F5E" Offset="1.0"/>  <!-- Soft Magenta Edge -->
    </LinearGradientBrush>

    <!-- Subdued Chromatic Rim (for ambient panels and inputs) -->
    <LinearGradientBrush x:Key="LiquidGlassSubtleChromaticBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1400E5FF" Offset="0.0"/>
        <GradientStop Color="#20FFFFFF" Offset="0.18"/>
        <GradientStop Color="#0A78BEFF" Offset="0.6"/>
        <GradientStop Color="#14B366FF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Multi-stage Inset Specular Bevel Brush -->
    <LinearGradientBrush x:Key="LiquidGlassMultiBevelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#35FFFFFF" Offset="0.0"/>
        <GradientStop Color="#10FFFFFF" Offset="0.22"/>
        <GradientStop Color="#03FFFFFF" Offset="0.6"/>
        <GradientStop Color="#0F78BEFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- General Elevated Glass Card Style with Soft Blend & Subtle Shadow -->
    <Style x:Key="LiquidGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel3Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusNormal}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingCardInner}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270"
                                  Color="#000000" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liquid Glass Capsule / Pill Container (.liquidglass capsule from 2211.zip) -->
    <Style x:Key="LiquidGlassCapsule" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2.5" Direction="270"
                                  Color="#000000" Opacity="0.32"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- macOS & 2211 Liquid Glass Container (.glassContainer equivalent) -->
    <Style x:Key="GlassContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270"
                                  Color="#000000" Opacity="0.38"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MacOSGlassContainer" TargetType="Border" BasedOn="{StaticResource GlassContainer}"/>

    <!-- Backward-Compatible Aliases for Card and Materials -->
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource LiquidGlassCard}"/>
    <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource LiquidGlassCard}"/>

    <!-- Token Aliases (mapping legacy names to LiquidGlass standards) -->
    <SolidColorBrush x:Key="LiquidGlassProgressTrackBrush" Color="#28168CFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#6008111F"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2E78BEFF"/>

</ResourceDictionary>
