<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= HARDWARE MEDIA TYPES & GRADIENTS ================= -->
    <SolidColorBrush x:Key="MediaNVMeBrush" Color="#00F0FF"/>
    <SolidColorBrush x:Key="MediaNVMeBackground" Color="#2000F0FF"/>
    <SolidColorBrush x:Key="MediaSsdBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="MediaSsdBackground" Color="#203B82F6"/>
    <SolidColorBrush x:Key="MediaHddBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="MediaHddBackground" Color="#20F59E0B"/>
    <SolidColorBrush x:Key="MediaUsbBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="MediaUsbBackground" Color="#2010B981"/>

    <!-- Partition Gradients -->
    <LinearGradientBrush x:Key="PartitionBasicDataGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#60A5FA" Offset="0.0"/>
        <GradientStop Color="#3B82F6" Offset="0.5"/>
        <GradientStop Color="#1D4ED8" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartitionSystemEfiGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0.0"/>
        <GradientStop Color="#10B981" Offset="0.5"/>
        <GradientStop Color="#047857" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartitionMsrGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0.0"/>
        <GradientStop Color="#F59E0B" Offset="0.5"/>
        <GradientStop Color="#B45309" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartitionRecoveryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C084FC" Offset="0.0"/>
        <GradientStop Color="#A855F7" Offset="0.5"/>
        <GradientStop Color="#7E22CE" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartitionUnallocatedGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#94A3B8" Offset="0.0"/>
        <GradientStop Color="#64748B" Offset="0.5"/>
        <GradientStop Color="#334155" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ================= MAIN NAVIGATION PILLS ================= -->
    <Style x:Key="FuturisticNavTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilySystem}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="1.5,0"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid WindowChrome.IsHitTestVisibleInChrome="True" SnapsToDevicePixels="True">
                        <!-- 1. Ambient Drop Shadow / Glow Host -->
                        <Border x:Name="ShadowHost" CornerRadius="14" Background="Transparent"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ShadowFx" BlurRadius="6" ShadowDepth="1.5" Direction="270"
                                                  Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.2"/>
                            </Border.Effect>
                        </Border>

                        <!-- 2. Dark Depth Core Refraction -->
                        <Border x:Name="DepthCore" Margin="1" CornerRadius="13"
                                Background="#10000000" IsHitTestVisible="False"
                                WindowChrome.IsHitTestVisibleInChrome="False"/>

                        <!-- 3. Base Glass Fill & Rim -->
                        <Border x:Name="TabBorder" CornerRadius="14"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True" WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- 4. Concentric Inset Specular Bevel -->
                        <Border x:Name="InnerBevel" Margin="1" CornerRadius="13"
                                BorderThickness="1" BorderBrush="{DynamicResource LiquidGlassBevelHighlight}"
                                IsHitTestVisible="False" Opacity="0"
                                WindowChrome.IsHitTestVisibleInChrome="False"/>

                        <!-- 5. 45° Specular Reflection Sheen -->
                        <Border x:Name="SpecularSheen" Margin="1" CornerRadius="13"
                                Background="{DynamicResource LiquidGlassSheenDiagonal}"
                                IsHitTestVisible="False" Opacity="0"
                                WindowChrome.IsHitTestVisibleInChrome="False"/>

                        <!-- 6. Content -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Optical Lift & Sheen Reflection -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.6"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="0.75"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                      Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                        <TranslateTransform X="0" Y="-1"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Checked: Brilliant 3D Chromatic Liquid Glass Pill (2211.zip) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource LiquidGlassAccentSoft}"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource LiquidGlassLensChromaticBorder}"/>
                            <Setter TargetName="InnerBevel" Property="BorderBrush" Value="{StaticResource MacOsLiquidGlassBevel}"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.85"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="1.5" Direction="270"
                                                      Color="{DynamicResource GlowAccentColor}" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="SpecularSheen" Property="Opacity" Value="0.2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassNavTab" TargetType="RadioButton" BasedOn="{StaticResource FuturisticNavTab}"/>

    <!-- ================= SIDEBAR NAVIGATION ================= -->
    <Style x:Key="SidebarNavItem" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavRoot"
                            CornerRadius="{DynamicResource RadiusNormal}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
                            <Setter TargetName="NavRoot" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Elevated Drive Card -->
    <Style x:Key="SidebarDriveCard" TargetType="Border">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusNormal}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorder}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                          Color="{DynamicResource LiquidGlassShadowColor}" Opacity="0.4"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
