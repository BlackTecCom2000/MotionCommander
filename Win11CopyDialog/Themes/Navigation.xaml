<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= HARDWARE MEDIA TYPES & GRADIENTS ================= -->
    <SolidColorBrush x:Key="MediaNVMeBrush" Color="#00F0FF"/>
    <SolidColorBrush x:Key="MediaNVMeBackground" Color="#2000F0FF"/>
    <SolidColorBrush x:Key="MediaSsdBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="MediaSsdBackground" Color="#203B82F6"/>
    <SolidColorBrush x:Key="MediaHddBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="MediaHddBackground" Color="#20F59E0B"/>
    <SolidColorBrush x:Key="MediaUsbBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="MediaUsbBackground" Color="#2010B981"/>

    <!-- Partition Gradients -->
    <LinearGradientBrush x:Key="PartitionBasicDataGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#60A5FA" Offset="0.0"/>
        <GradientStop Color="#3B82F6" Offset="0.5"/>
        <GradientStop Color="#1D4ED8" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartitionSystemEfiGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0.0"/>
        <GradientStop Color="#10B981" Offset="0.5"/>
        <GradientStop Color="#047857" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartitionMsrGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0.0"/>
        <GradientStop Color="#F59E0B" Offset="0.5"/>
        <GradientStop Color="#B45309" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartitionRecoveryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C084FC" Offset="0.0"/>
        <GradientStop Color="#A855F7" Offset="0.5"/>
        <GradientStop Color="#7E22CE" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartitionUnallocatedGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#94A3B8" Offset="0.0"/>
        <GradientStop Color="#64748B" Offset="0.5"/>
        <GradientStop Color="#334155" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ================= MAIN NAVIGATION PILLS ================= -->
    <Style x:Key="FuturisticNavTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilySystem}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="1.5,0"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid WindowChrome.IsHitTestVisibleInChrome="True" SnapsToDevicePixels="True">
                        <!-- 1. Ambient Drop Shadow / Glow Host -->
                        <Border x:Name="ShadowHost" CornerRadius="{DynamicResource RadiusMedium}" Background="Transparent"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- 2. Base Glass Fill & Rim (seamless normal state) -->
                        <Border x:Name="TabBorder" CornerRadius="{DynamicResource RadiusMedium}"
                                Background="Transparent" BorderBrush="{StaticResource GlassBorderInvisible}" BorderThickness="1"
                                SnapsToDevicePixels="True" WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- 3. Soft Inset Specular Top Highlight -->
                        <Border x:Name="InnerBevel" Margin="1" CornerRadius="{DynamicResource RadiusMedium}"
                                BorderThickness="0,1,0,0" BorderBrush="{StaticResource GlassSpecularHighlight}"
                                IsHitTestVisible="False" Opacity="0"
                                WindowChrome.IsHitTestVisibleInChrome="False"/>

                        <!-- 4. Content -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Soft Optical Lift & Reflection (Rule 7 & Rule 23) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="0.6"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1.5" Direction="270"
                                                      Color="#000000" Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                                        <TranslateTransform X="0" Y="-0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Checked: Soft Ambient Accent Illumination from within the glass (Rule 7) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource LiquidGlassAccentSoft}"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource GlassBorderDefault}"/>
                            <Setter TargetName="InnerBevel" Property="Opacity" Value="0.8"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="ShadowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270"
                                                      Color="{DynamicResource GlowAccentColor}" Opacity="0.45"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        <TranslateTransform X="0" Y="0.5"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassNavTab" TargetType="RadioButton" BasedOn="{StaticResource FuturisticNavTab}"/>

    <!-- ================= SIDEBAR NAVIGATION (Rule 8) ================= -->
    <Style x:Key="SidebarNavItem" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderInvisible}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavRoot"
                            CornerRadius="{DynamicResource RadiusMedium}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Soft subtle illumination on hover without aggressive outlines -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
                            <Setter TargetName="NavRoot" Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Elevated Drive Card (Soft continuous elevation, no hard box outline) -->
    <Style x:Key="SidebarDriveCard" TargetType="Border">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceFloating}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderDefault}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                          Color="#000000" Opacity="0.35"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
