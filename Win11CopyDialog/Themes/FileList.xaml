<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:Win11CopyDialog.Helpers">

    <!-- ================= LIQUID GLASS FILE LIST & TABLE (Rules 5, 9, 22) ================= -->

    <!-- GridView Column Header (One continuous header surface, zero vertical divider lines - Rule 9) -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilySystem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liquid Glass ListViewItem (Rule 5: flat/continuous, NOT a pill; Rule 22: illuminated from within without harsh blue outlines) -->
    <Style TargetType="ListViewItem">
        <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="0,0.5"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ItemBorder" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource GlassBorderInvisible}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Selection Left Accent Soft Indicator -->
                            <Border x:Name="LeftAccent" Width="2.5" HorizontalAlignment="Left" Margin="-8,-2,0,-2"
                                    CornerRadius="1.25" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <GridViewRowPresenter VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover State: Whisper-soft ambient glass illumination -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
                        </Trigger>
                        <!-- Selected State: Soft accent-tinted surface illuminated from within, no hard border -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GlassBorderDefault}"/>
                            <Setter TargetName="LeftAccent" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Virtualized ListView Master Style -->
    <Style TargetType="{x:Type ListView}">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="helpers:SmoothScroll.IsEnabled" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Virtualized ListBox Master Style -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="helpers:SmoothScroll.IsEnabled" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</ResourceDictionary>
