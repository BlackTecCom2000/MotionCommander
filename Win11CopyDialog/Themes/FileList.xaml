<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:Win11CopyDialog.Helpers">

    <!-- ================= LIQUID GLASS FILE LIST & TABLE ================= -->

    <!-- GridView Column Header -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}"/>
        <Setter Property="Background" Value="{DynamicResource LiquidGlassPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilySystem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liquid Glass ListViewItem (High Performance, Zero Per-Row Blur) -->
    <Style TargetType="ListViewItem">
        <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ItemBorder" CornerRadius="{DynamicResource RadiusSmall}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Selection Left Accent Pill -->
                            <Border x:Name="LeftAccent" Width="3" HorizontalAlignment="Left" Margin="-6,-2,0,-2"
                                    CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{DynamicResource GlowAccentColor}" Opacity="0.8"/>
                                </Border.Effect>
                            </Border>
                            <GridViewRowPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LiquidGlassSurfaceElevated}"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderSubtle}"/>
                        </Trigger>
                        <!-- Selected State -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LiquidGlassActiveHighlight}"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource LiquidGlassBorder}"/>
                            <Setter TargetName="LeftAccent" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Virtualized ListView Master Style -->
    <Style TargetType="{x:Type ListView}">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="helpers:SmoothScroll.IsEnabled" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Virtualized ListBox Master Style -->
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="helpers:SmoothScroll.IsEnabled" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</ResourceDictionary>
