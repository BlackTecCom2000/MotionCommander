<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =========================================================================
         MOTION COMMANDER — GLOBAL LIQUID GLASS DIVIDER SYSTEM (Dividers.xaml)
         
         Architecture:
         1. Concept: Surfaces separated by soft material transitions, light refraction
            and ambient falloff rather than harsh 1px opaque borders.
         2. Components:
            - LiquidGlassDivider (Horizontal & Vertical)
            - LiquidGlassSplitter (Interactive GridSplitter)
         3. Semantic Variants:
            - GlassDividerSubtle
            - GlassDividerDefault
            - GlassDividerStrong
            - GlassDividerAccent
         4. Material Structure:
            - Soft light / specular edge (top or left)
            - Glass core (translucent low-opacity optical band)
            - Soft ambient falloff (depth dispersion)
         ========================================================================= -->

    <!-- =========================================================================
         1. GLOBAL DIVIDER DESIGN TOKENS
         ========================================================================= -->

    <!-- Standard Dimensions (DPI-Safe) -->
    <sys:Double x:Key="GlassDividerThickness">1</sys:Double>
    <sys:Double x:Key="GlassDividerHoverThickness">2</sys:Double>
    <sys:Double x:Key="GlassDividerDraggingThickness">3</sys:Double>

    <!-- Splitter Grip Widths -->
    <sys:Double x:Key="GlassSplitterHitWidth">6</sys:Double>
    <sys:Double x:Key="GlassSplitterVisibleWidth">1</sys:Double>

    <!-- Core Material Falloff Linear Gradients (Horizontal: Left -> Center -> Right falloff) -->
    <LinearGradientBrush x:Key="GlassDividerCoreHorizontalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#0078BEFF" Offset="0.0"/>
        <GradientStop Color="#1878BEFF" Offset="0.15"/>
        <GradientStop Color="#28FFFFFF" Offset="0.5"/>
        <GradientStop Color="#1878BEFF" Offset="0.85"/>
        <GradientStop Color="#0078BEFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Core Material Falloff Linear Gradients (Vertical: Top -> Center -> Bottom falloff) -->
    <LinearGradientBrush x:Key="GlassDividerCoreVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0078BEFF" Offset="0.0"/>
        <GradientStop Color="#1878BEFF" Offset="0.15"/>
        <GradientStop Color="#28FFFFFF" Offset="0.5"/>
        <GradientStop Color="#1878BEFF" Offset="0.85"/>
        <GradientStop Color="#0078BEFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Subtle Horizontal Divider (ultra-soft refraction) -->
    <LinearGradientBrush x:Key="GlassDividerSubtleHorizontalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#08FFFFFF" Offset="0.2"/>
        <GradientStop Color="#15FFFFFF" Offset="0.5"/>
        <GradientStop Color="#08FFFFFF" Offset="0.8"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Subtle Vertical Divider -->
    <LinearGradientBrush x:Key="GlassDividerSubtleVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#08FFFFFF" Offset="0.2"/>
        <GradientStop Color="#15FFFFFF" Offset="0.5"/>
        <GradientStop Color="#08FFFFFF" Offset="0.8"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Strong Material Divider (Distinct structural boundaries e.g. Major Workspace regions) -->
    <LinearGradientBrush x:Key="GlassDividerStrongHorizontalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#0578BEFF" Offset="0.0"/>
        <GradientStop Color="#2578BEFF" Offset="0.15"/>
        <GradientStop Color="#45FFFFFF" Offset="0.5"/>
        <GradientStop Color="#2578BEFF" Offset="0.85"/>
        <GradientStop Color="#0578BEFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassDividerStrongVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0578BEFF" Offset="0.0"/>
        <GradientStop Color="#2578BEFF" Offset="0.15"/>
        <GradientStop Color="#45FFFFFF" Offset="0.5"/>
        <GradientStop Color="#2578BEFF" Offset="0.85"/>
        <GradientStop Color="#0578BEFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Interactive Dragging / Active Splitter Glow Brush -->
    <LinearGradientBrush x:Key="GlassDividerAccentVerticalBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#1000D4FF" Offset="0.0"/>
        <GradientStop Color="#6000D4FF" Offset="0.2"/>
        <GradientStop Color="#DDFFFFFF" Offset="0.5"/>
        <GradientStop Color="#6000D4FF" Offset="0.8"/>
        <GradientStop Color="#1000D4FF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassDividerAccentHorizontalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#1000D4FF" Offset="0.0"/>
        <GradientStop Color="#6000D4FF" Offset="0.2"/>
        <GradientStop Color="#DDFFFFFF" Offset="0.5"/>
        <GradientStop Color="#6000D4FF" Offset="0.8"/>
        <GradientStop Color="#1000D4FF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top Soft Ambient Sheen Overlay (Creates Depth in 3-Tier Layering) -->
    <LinearGradientBrush x:Key="GlassDividerTopSheen" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#18FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassDividerBottomFalloff" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00000000" Offset="0.0"/>
        <GradientStop Color="#20000000" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- =========================================================================
         2. REUSABLE DIVIDER STYLES (Separator Controls)
         ========================================================================= -->

    <!-- Base Liquid Glass Horizontal Divider Style -->
    <Style x:Key="LiquidGlassDivider" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1"/>
        <Setter Property="MinHeight" Value="1"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Background" Value="{StaticResource GlassDividerCoreHorizontalBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid SnapsToDevicePixels="True" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}">
                        <!-- Specular Soft Line of Light -->
                        <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Semantic Variant: Subtle (Near-invisible organic boundary) -->
    <Style x:Key="LiquidGlassDividerSubtle" TargetType="{x:Type Separator}" BasedOn="{StaticResource LiquidGlassDivider}">
        <Setter Property="Background" Value="{StaticResource GlassDividerSubtleHorizontalBrush}"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>

    <!-- Semantic Variant: Strong (Major architectural structural break) -->
    <Style x:Key="LiquidGlassDividerStrong" TargetType="{x:Type Separator}" BasedOn="{StaticResource LiquidGlassDivider}">
        <Setter Property="Background" Value="{StaticResource GlassDividerStrongHorizontalBrush}"/>
        <Setter Property="Margin" Value="0,6"/>
    </Style>

    <!-- Semantic Variant: Accent (Highlighted / focused category break) -->
    <Style x:Key="LiquidGlassDividerAccent" TargetType="{x:Type Separator}" BasedOn="{StaticResource LiquidGlassDivider}">
        <Setter Property="Background" Value="{StaticResource GlassDividerAccentHorizontalBrush}"/>
        <Setter Property="Margin" Value="0,5"/>
    </Style>

    <!-- Vertical Divider Variant (For Toolbars, Command bars, Ribbon button groups) -->
    <Style x:Key="LiquidGlassDividerVertical" TargetType="{x:Type Separator}">
        <Setter Property="Width" Value="1"/>
        <Setter Property="MinWidth" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Background" Value="{StaticResource GlassDividerCoreVerticalBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid SnapsToDevicePixels="True" Width="{TemplateBinding Width}" Margin="{TemplateBinding Margin}">
                        <!-- Vertical line of refracted light -->
                        <Border Width="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LiquidGlassDividerVerticalSubtle" TargetType="{x:Type Separator}" BasedOn="{StaticResource LiquidGlassDividerVertical}">
        <Setter Property="Background" Value="{StaticResource GlassDividerSubtleVerticalBrush}"/>
        <Setter Property="Margin" Value="4,4"/>
    </Style>

    <!-- Default Separator Override -->
    <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource LiquidGlassDivider}"/>

    <!-- =========================================================================
         3. REUSABLE INTERACTIVE SPLITTER SYSTEM (LiquidGlassSplitter)
         Interactive States: Normal, Hover, Dragging, Focused
         ========================================================================= -->

    <!-- Vertical Splitter (Sidebar ↔ FileList and FileList ↔ Inspector) -->
    <Style x:Key="LiquidGlassSplitter" TargetType="{x:Type GridSplitter}">
        <Setter Property="Width" Value="{StaticResource GlassSplitterHitWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid x:Name="SplitterRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Soft Ambient Dispersion Field (glows on hover/dragging) -->
                        <Border x:Name="AmbientGlow" Width="4" HorizontalAlignment="Center"
                                Background="{DynamicResource GlowAccentBrush}" Opacity="0"
                                CornerRadius="2" IsHitTestVisible="False"/>

                        <!-- Center Light Refraction Core (1px hairline) -->
                        <Border x:Name="GlassCore" Width="1" HorizontalAlignment="Center"
                                Background="{StaticResource GlassDividerCoreVerticalBrush}"
                                Opacity="0.55" SnapsToDevicePixels="True"/>

                        <!-- Center Subtle Dot Handle for Tactile Feedback -->
                        <Border x:Name="GripHandle" Width="2" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="1" Background="{DynamicResource GlassBorderSubtle}" Opacity="0.4"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Hover State: Subtle accent illumination & slight core flare -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlassCore" Property="Background" Value="{StaticResource GlassDividerAccentVerticalBrush}"/>
                            <Setter TargetName="GlassCore" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="AmbientGlow" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="GripHandle" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="GripHandle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>

                        <!-- Dragging State: Rich luminous core and soft ambient halo -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="GlassCore" Property="Background" Value="{StaticResource GlassDividerAccentVerticalBrush}"/>
                            <Setter TargetName="GlassCore" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="AmbientGlow" Property="Opacity" Value="0.75"/>
                            <Setter TargetName="AmbientGlow" Property="Width" Value="6"/>
                            <Setter TargetName="GripHandle" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="GripHandle" Property="Height" Value="40"/>
                            <Setter TargetName="GripHandle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>

                        <!-- Keyboard Focus State: Organic focus treatment -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="GlassCore" Property="Background" Value="{StaticResource GlassDividerAccentVerticalBrush}"/>
                            <Setter TargetName="GlassCore" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="AmbientGlow" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal Splitter Variant (For stacked split views) -->
    <Style x:Key="LiquidGlassSplitterHorizontal" TargetType="{x:Type GridSplitter}">
        <Setter Property="Height" Value="{StaticResource GlassSplitterHitWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid x:Name="SplitterRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="AmbientGlow" Height="4" VerticalAlignment="Center"
                                Background="{DynamicResource GlowAccentBrush}" Opacity="0"
                                CornerRadius="2" IsHitTestVisible="False"/>

                        <Border x:Name="GlassCore" Height="1" VerticalAlignment="Center"
                                Background="{StaticResource GlassDividerCoreHorizontalBrush}"
                                Opacity="0.55" SnapsToDevicePixels="True"/>

                        <Border x:Name="GripHandle" Height="2" Width="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="1" Background="{DynamicResource GlassBorderSubtle}" Opacity="0.4"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlassCore" Property="Background" Value="{StaticResource GlassDividerAccentHorizontalBrush}"/>
                            <Setter TargetName="GlassCore" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="AmbientGlow" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="GripHandle" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="GripHandle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="GlassCore" Property="Background" Value="{StaticResource GlassDividerAccentHorizontalBrush}"/>
                            <Setter TargetName="GlassCore" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="AmbientGlow" Property="Opacity" Value="0.75"/>
                            <Setter TargetName="AmbientGlow" Property="Height" Value="6"/>
                            <Setter TargetName="GripHandle" Property="Opacity" Value="1.0"/>
                            <Setter TargetName="GripHandle" Property="Width" Value="40"/>
                            <Setter TargetName="GripHandle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="GlassCore" Property="Background" Value="{StaticResource GlassDividerAccentHorizontalBrush}"/>
                            <Setter TargetName="GlassCore" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="AmbientGlow" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
