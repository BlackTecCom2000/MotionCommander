<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         MOTION COMMANDER — LIQUID GLASS DIALOG & MODAL SYSTEM (Dialogs.xaml)
         ========================================================================= -->

    <!-- Modal Backdrop Scrim Overlay -->
    <Style x:Key="GlassModalBackdrop" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#A6030712"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- Modal Dialog Card Container -->
    <Style x:Key="GlassDialogCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel4Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassBorderLevel3Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXL}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingDialog}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="32"
                                  ShadowDepth="8"
                                  Direction="270"
                                  Color="#000000"
                                  Opacity="0.65"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog Header -->
    <Style x:Key="GlassDialogHeader" TargetType="{x:Type DockPanel}">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="LastChildFill" Value="True"/>
    </Style>

    <!-- Dialog Footer (Actions) -->
    <Style x:Key="GlassDialogFooter" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,20,0,0"/>
    </Style>

    <!-- Base Window Style for Glass Popups / Dialogs -->
    <Style x:Key="GlassDialogWindow" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel0Brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource BaseFontFamily}"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

</ResourceDictionary>
