<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         MOTION COMMANDER — LIQUID GLASS DIALOG & MODAL SYSTEM (Dialogs.xaml)
         Full chromatic-lens aesthetic: multi-bevel specular highlights,
         RGB-dispersion borders, capsule morphology, ambient glow backdrops.
         Reference: 2211.zip (liquid-glass-distortion-card-in-css-and-svg)
         ========================================================================= -->

    <!-- ── SCRIM OVERLAY ─────────────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="GlassModalScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#C8010208" Offset="0.0"/>
        <GradientStop Color="#E0020510" Offset="1.0"/>
    </LinearGradientBrush>

    <Style x:Key="GlassModalBackdrop" TargetType="{x:Type Border}">
        <Setter Property="Background"          Value="{StaticResource GlassModalScrimBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment"   Value="Stretch"/>
    </Style>

    <!-- ── DIALOG CARD CHROMATIC BEVEL (top-left cyan -> violet -> magenta) ── -->
    <LinearGradientBrush x:Key="DialogChromaticBevel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7000E5FF"  Offset="0.0"/>
        <GradientStop Color="#BBFFFFFF"  Offset="0.10"/>
        <GradientStop Color="#35FFFFFF"  Offset="0.28"/>
        <GradientStop Color="#1278BEFF"  Offset="0.58"/>
        <GradientStop Color="#50B366FF"  Offset="0.85"/>
        <GradientStop Color="#40F43F5E"  Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Multi-stage top-edge inset specular sheen -->
    <LinearGradientBrush x:Key="DialogBevelSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90FFFFFF"  Offset="0.0"/>
        <GradientStop Color="#28FFFFFF"  Offset="0.22"/>
        <GradientStop Color="#08FFFFFF"  Offset="0.70"/>
        <GradientStop Color="#25FFFFFF"  Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ── MODAL DIALOG CARD CONTAINER ─────────────────────────────────── -->
    <Style x:Key="GlassDialogCard" TargetType="{x:Type Border}">
        <Setter Property="Background"          Value="{DynamicResource LiquidGlassMaterialLevel5Brush}"/>
        <Setter Property="BorderBrush"         Value="{StaticResource DialogChromaticBevel}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="20"/>
        <Setter Property="Padding"             Value="28,24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="48" ShadowDepth="12"
                                  Direction="270" Color="#000000" Opacity="0.72"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inner inset specular highlight overlay -->
    <Style x:Key="GlassDialogCardInner" TargetType="{x:Type Border}">
        <Setter Property="Background"       Value="{StaticResource DialogBevelSheen}"/>
        <Setter Property="BorderBrush"      Value="#18FFFFFF"/>
        <Setter Property="BorderThickness"  Value="0,1,0,0"/>
        <Setter Property="CornerRadius"     Value="19"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ── WINDOW ROOT CONTAINER (all secondary windows) ───────────────── -->
    <Style x:Key="GlassWindowRoot" TargetType="{x:Type Border}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                    <GradientStop Color="#E60A1426" Offset="0.0"/>
                    <GradientStop Color="#F00B1830" Offset="0.55"/>
                    <GradientStop Color="#E80A1220" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush"         Value="{StaticResource DialogChromaticBevel}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10"
                                  Direction="270" Color="#000000" Opacity="0.70"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TITLE BAR ────────────────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="DialogTitleBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#180C1826" Offset="0.0"/>
        <GradientStop Color="#00000000" Offset="1.0"/>
    </LinearGradientBrush>

    <Style x:Key="GlassDialogTitleBar" TargetType="{x:Type Border}">
        <Setter Property="Background"      Value="{StaticResource DialogTitleBarBrush}"/>
        <Setter Property="BorderBrush"     Value="#14FFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius"    Value="12,12,0,0"/>
    </Style>

    <!-- ── DIALOG HEADER / FOOTER ───────────────────────────────────────── -->
    <Style x:Key="GlassDialogHeader" TargetType="{x:Type DockPanel}">
        <Setter Property="Margin"        Value="0,0,0,18"/>
        <Setter Property="LastChildFill" Value="True"/>
    </Style>

    <Style x:Key="GlassDialogFooter" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation"         Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin"              Value="0,22,0,0"/>
    </Style>

    <!-- ── FLOATING GLASS DOCK (bottom action bar) ──────────────────────── -->
    <Style x:Key="GlassFloatingDock" TargetType="{x:Type Border}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B50D1929" Offset="0.0"/>
                    <GradientStop Color="#C80A1420" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush"         Value="{StaticResource DialogChromaticBevel}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="CornerRadius"        Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5"
                                  Direction="270" Color="#00D4FF" Opacity="0.30"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── STAT / BENTO CARD ────────────────────────────────────────────── -->
    <Style x:Key="GlassStatCard" TargetType="{x:Type Border}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                    <GradientStop Color="#960C1A2E" Offset="0.0"/>
                    <GradientStop Color="#780A1422" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush"         Value="{StaticResource DialogChromaticBevel}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="CornerRadius"        Value="12"/>
        <Setter Property="Padding"             Value="11,9"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                         To="1.04" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                         To="1.04" Duration="0:0:0.14"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                         To="1" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                         To="1" Duration="0:0:0.14"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── GLASS STATUS PILL (header beacon chip) ───────────────────────── -->
    <Style x:Key="GlassStatusPill" TargetType="{x:Type Border}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#550C1A2E" Offset="0.0"/>
                    <GradientStop Color="#380A1220" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush"         Value="{StaticResource DialogChromaticBevel}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="CornerRadius"        Value="9999"/>
        <Setter Property="Padding"             Value="12,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ── GLASS SECTION CARD (waveform / file list panels) ─────────────── -->
    <Style x:Key="GlassSectionCard" TargetType="{x:Type Border}"
           BasedOn="{StaticResource LiquidGlassCard}">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding"      Value="14,11"/>
        <Setter Property="Margin"       Value="0,0,0,12"/>
    </Style>

    <!-- ── TOOLBAR GLASS BAR ─────────────────────────────────────────────── -->
    <Style x:Key="GlassToolbar" TargetType="{x:Type Border}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#AA0C1824" Offset="0.0"/>
                    <GradientStop Color="#880A1020" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush"     Value="{StaticResource DialogChromaticBevel}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding"         Value="8,6"/>
    </Style>

    <!-- ── SIDEBAR GLASS PANE ────────────────────────────────────────────── -->
    <Style x:Key="GlassSidebarPane" TargetType="{x:Type Border}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D00A1220" Offset="0.0"/>
                    <GradientStop Color="#C00C1830" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush"     Value="{StaticResource LiquidGlassLensChromaticBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <!-- ── COPY OVERLAY GLASS CARD ──────────────────────────────────────── -->
    <Style x:Key="GlassCopyOverlayCard" TargetType="{x:Type Border}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop Color="#F00C1A2C" Offset="0.0"/>
                    <GradientStop Color="#F00A1220" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush"         Value="{StaticResource DialogChromaticBevel}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="20"/>
        <Setter Property="Padding"             Value="28,22"/>
        <Setter Property="MaxWidth"            Value="500"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="50" ShadowDepth="12"
                                  Direction="270" Color="#000000" Opacity="0.75"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── BASE GLASS WINDOW STYLE ──────────────────────────────────────── -->
    <Style x:Key="GlassDialogWindow" TargetType="{x:Type Window}">
        <Setter Property="Background"         Value="{DynamicResource LiquidGlassMaterialLevel0Brush}"/>
        <Setter Property="Foreground"         Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily"         Value="{DynamicResource BaseFontFamily}"/>
        <Setter Property="WindowStyle"        Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="ResizeMode"         Value="NoResize"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
        <Setter Property="UseLayoutRounding"    Value="True"/>
    </Style>

    <!-- ── GLASS SLIDER ─────────────────────────────────────────────────── -->
    <Style x:Key="GlassSliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Ellipse Width="18" Height="18" Fill="{DynamicResource LiquidGlassMaterialLevel3Brush}"
                                 Stroke="{DynamicResource DialogChromaticBevel}" StrokeThickness="1.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Direction="270" Color="#000000" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSlider" TargetType="{x:Type Slider}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource LiquidGlassInputBackgroundBrush}"
                                BorderBrush="{DynamicResource LiquidGlassInputBorderBrush}" BorderThickness="1"/>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource GlassSliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource GlassSlider}"/>

    <!-- ── GLASS TAB CONTROL & TAB ITEM ─────────────────────────────────── -->
    <Style x:Key="GlassTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="tabBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8,8,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource LiquidGlassSubtleBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel3Brush}"/>
                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource DialogChromaticBevel}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource GlassTabItem}"/>

    <Style x:Key="GlassTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource GlassTabControl}"/>

    <!-- ── GLASS LISTVIEW / GRIDVIEW HEADER ─────────────────────────────── -->
    <Style x:Key="GlassGridViewColumnHeader" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource GlassGridViewColumnHeader}"/>

    <!-- ── GLASS STATUSBAR CARD ─────────────────────────────────────────── -->
    <Style x:Key="GlassStatusBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassMaterialLevel2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidGlassInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

</ResourceDictionary>
