<Window x:Class="Win11CopyDialog.CopyDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Win11CopyDialog.Controls"
        Title="Копирование" Height="348" Width="500" MinWidth="420" MinHeight="200"
        Background="Transparent" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="8,8,8,8"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="8">
        <DockPanel>
            <!-- Кастомный заголовок -->
            <Grid DockPanel.Dock="Top" Height="40" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Text="Копирование" Margin="8,0,0,0"
                               Foreground="{DynamicResource TitleForegroundBrush}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="PinButton" Style="{StaticResource CaptionButton}" Content="📌" ToolTip="Поверх всех окон" Click="PinButton_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="─" Click="MinButton_Click"/>
                    <Button Style="{StaticResource CaptionCloseButton}" Content="✕" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,6,20,16">
                <StackPanel>
                    <!-- Процент + кнопки управления -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PercentText" Text="0% завершено" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="PauseButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                Content="⏸" ToolTip="Приостановить" Click="PauseButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="CancelTopButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                Content="✕" ToolTip="Отменить" Click="CancelButton_Click"/>
                    </Grid>

                    <!-- Текущий файл -->
                    <TextBlock x:Name="FileNameText" Text="Подготовка…" Margin="0,8,0,0" FontSize="13"
                               Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PathText" Margin="0,2,0,0" FontSize="12"
                               Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="0,4,0,0" FontSize="12" Style="{StaticResource MutedText}">
                        <Run Text="Скорость: "/><Run x:Name="SpeedRun" Text="—"/>
                        <Run Text="   •   Осталось: "/><Run x:Name="EtaRun" Text="—"/>
                    </TextBlock>

                    <!-- Общий прогресс -->
                    <ProgressBar x:Name="TotalProgress" Minimum="0" Maximum="100" Height="5" Margin="0,12,0,0"
                                 Background="{DynamicResource ProgressTrackBrush}"
                                 Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>

                    <!-- Кнопка подробностей -->
                    <Button x:Name="DetailsButton" Style="{StaticResource Win11Button}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,4"
                            Content="Подробнее ⌄" Click="DetailsButton_Click"/>

                    <!-- Развёрнутая часть -->
                    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                        <TextBlock Text="Текущий файл" Margin="0,14,0,4" FontSize="12" Style="{StaticResource MutedText}"/>
                        <ProgressBar x:Name="FileProgress" Minimum="0" Maximum="100" Height="5"
                                     Background="{DynamicResource ProgressTrackBrush}"
                                     Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>

                        <TextBlock Text="Скорость" Margin="0,14,0,4" FontSize="12" Style="{StaticResource MutedText}"/>
                        <Border Style="{StaticResource Card}" Padding="8">
                            <ctrl:SpeedGraph x:Name="Graph" Height="90"/>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="12" Style="{StaticResource MutedText}">
                                <Run Text="Элементов: "/><Run x:Name="ItemsRun" Text="0 / 0"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="12" Style="{StaticResource MutedText}" TextAlignment="Right">
                                <Run Text="Скопировано: "/><Run x:Name="BytesRun" Text="—"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" FontSize="12" Style="{StaticResource MutedText}">
                                <Run Text="Прошло: "/><Run x:Name="ElapsedRun" Text="0:00"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Style="{StaticResource MutedText}" TextAlignment="Right">
                                <Run Text="Осталось: "/><Run x:Name="LeftRun" Text="—"/>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="Файлы (двойной клик — пропустить)" Margin="0,14,0,4" FontSize="12" Style="{StaticResource MutedText}"/>
                        <Border Style="{StaticResource Card}" Padding="0" MaxHeight="180">
                            <ListView x:Name="FilesList" BorderThickness="0" MaxHeight="178"
                                      Background="Transparent" MouseDoubleClick="FilesList_DoubleClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ListHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="30" DisplayMemberBinding="{Binding StatusGlyph}"/>
                                        <GridViewColumn Header="Имя" Width="250" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Размер" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                                        <GridViewColumn Header="Прогресс" Width="70" DisplayMemberBinding="{Binding Progress, StringFormat='{}{0:0}%'}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <!-- Нижняя панель действий -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                            <Button x:Name="SkipButton" Style="{StaticResource Win11Button}" Content="Пропустить файл" Click="SkipButton_Click" Margin="0,0,8,0"/>
                            <Button x:Name="PauseBottomButton" Style="{StaticResource Win11Button}" Content="Пауза" Click="PauseButton_Click" Margin="0,0,8,0"/>
                            <Button x:Name="CloseButton" Style="{StaticResource AccentButton}" Content="Отмена" Click="CancelButton_Click" MinWidth="110"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
