<Window x:Class="Win11CopyDialog.CopyDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Win11CopyDialog.Controls"
        Title="Копирование" Height="360" Width="500" MinWidth="420" MinHeight="220"
        Background="Transparent" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" CornerRadius="12,12,12,12"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <!-- Root: Liquid Glass Window Shell -->
    <Border Style="{StaticResource GlassWindowRoot}">
        <DockPanel>

            <!-- ── TITLE BAR ─────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Style="{StaticResource GlassDialogTitleBar}" Height="44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon + Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,9,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                  Color="#00D4FF" Opacity="0.85"/>
                            </Border.Effect>
                            <TextBlock Text="📄" FontSize="13" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText" Text="Копирование"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button x:Name="PinButton" Style="{StaticResource CaptionButton}"
                                Content="📌" ToolTip="Поверх всех окон" Click="PinButton_Click"/>
                        <Button Style="{StaticResource CaptionButton}" Content="─" Click="MinButton_Click"/>
                        <Button Style="{StaticResource CaptionCloseButton}" Content="✕" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── MAIN CONTENT ──────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,12,20,16">
                <StackPanel>
                    <!-- Percent + control buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PercentText" Text="0% завершено" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00D4FF" Opacity="0.40"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Button x:Name="PauseButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                Content="⏸" ToolTip="Приостановить" Click="PauseButton_Click" Margin="0,0,4,0"/>
                        <Button x:Name="CancelTopButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                Content="✕" ToolTip="Отменить" Click="CancelButton_Click"/>
                    </Grid>

                    <!-- Current file info -->
                    <TextBlock x:Name="FileNameText" Text="Подготовка…" Margin="0,10,0,0" FontSize="13"
                               Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PathText" Margin="0,2,0,0" FontSize="12"
                               Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="0,4,0,0" FontSize="12" Style="{StaticResource MutedText}">
                        <Run Text="Скорость: "/><Run x:Name="SpeedRun" Text="—"/>
                        <Run Text="   •   Осталось: "/><Run x:Name="EtaRun" Text="—"/>
                    </TextBlock>

                    <!-- Total progress bar -->
                    <ProgressBar x:Name="TotalProgress" Minimum="0" Maximum="100" Height="5" Margin="0,14,0,0"
                                 Background="{DynamicResource ProgressTrackBrush}"
                                 Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>

                    <!-- Details toggle button -->
                    <Button x:Name="DetailsButton" Style="{StaticResource Win11Button}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,5"
                            Content="Подробнее ⌄" Click="DetailsButton_Click"/>

                    <!-- Expanded detail panel -->
                    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                        <TextBlock Text="Текущий файл" Margin="0,14,0,4" FontSize="12"
                                   Style="{StaticResource MutedText}"/>
                        <ProgressBar x:Name="FileProgress" Minimum="0" Maximum="100" Height="5"
                                     Background="{DynamicResource ProgressTrackBrush}"
                                     Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>

                        <TextBlock Text="Скорость" Margin="0,14,0,4" FontSize="12" Style="{StaticResource MutedText}"/>
                        <Border Style="{StaticResource GlassSectionCard}" Padding="10">
                            <ctrl:SpeedGraph x:Name="Graph" Height="90"/>
                        </Border>

                        <!-- Stats grid -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="12" Style="{StaticResource MutedText}">
                                <Run Text="Элементов: "/><Run x:Name="ItemsRun" Text="0 / 0"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="12" Style="{StaticResource MutedText}" TextAlignment="Right">
                                <Run Text="Скопировано: "/><Run x:Name="BytesRun" Text="—"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" FontSize="12" Style="{StaticResource MutedText}">
                                <Run Text="Прошло: "/><Run x:Name="ElapsedRun" Text="0:00"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Style="{StaticResource MutedText}" TextAlignment="Right">
                                <Run Text="Осталось: "/><Run x:Name="LeftRun" Text="—"/>
                            </TextBlock>
                        </Grid>

                        <!-- File list -->
                        <TextBlock Text="Файлы (двойной клик — пропустить)" Margin="0,14,0,4"
                                   FontSize="12" Style="{StaticResource MutedText}"/>
                        <Border Style="{StaticResource GlassSectionCard}" Padding="0" MaxHeight="180">
                            <ListView x:Name="FilesList" BorderThickness="0" MaxHeight="178"
                                      Background="Transparent" MouseDoubleClick="FilesList_DoubleClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding"    Value="8,5"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ListHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="30" DisplayMemberBinding="{Binding StatusGlyph}"/>
                                        <GridViewColumn Header="Имя" Width="250" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Размер" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                                        <GridViewColumn Header="Прогресс" Width="70"
                                                        DisplayMemberBinding="{Binding Progress, StringFormat='{}{0:0}%'}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <!-- Action bar -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                            <Button x:Name="SkipButton" Style="{StaticResource Win11Button}"
                                    Content="Пропустить файл" Click="SkipButton_Click" Margin="0,0,8,0"/>
                            <Button x:Name="PauseBottomButton" Style="{StaticResource Win11Button}"
                                    Content="Пауза" Click="PauseButton_Click" Margin="0,0,8,0"/>
                            <Button x:Name="CloseButton" Style="{StaticResource AccentButton}"
                                    Content="Отмена" Click="CancelButton_Click" MinWidth="110"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
