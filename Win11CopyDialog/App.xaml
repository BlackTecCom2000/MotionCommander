        <!-- 3D Cyber Button (3D Button Architect) с плавным неоновым сиянием и мягким светом -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Мягкое неоновое свечение (Ambient Aura) -->
                            <Border CornerRadius="8" Margin="-1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270"
                                                      Color="{DynamicResource GlowAccentColor}" Opacity="0.6"/>
                                </Border.Effect>
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource GlowAccentColor}"/>
                                </Border.Background>
                            </Border>

                            <!-- Основное тело кнопки -->
                            <Border x:Name="OuterBorder" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    Background="{DynamicResource CyberButtonGradientBrush}">
                                <Grid ClipToBounds="True">
                                    <!-- Плавный световой градиент (Smooth Shimmer Wave) -->
                                    <Rectangle x:Name="Beam" Width="100" HorizontalAlignment="Left"
                                               RenderTransformOrigin="0.5,0.5" Opacity="0">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop Color="#33FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform AngleX="-20"/>
                                                <TranslateTransform x:Name="BeamTransform" X="-120"/>
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>

                                    <!-- Контент -->
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="14,6"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Beam" Storyboard.TargetProperty="Opacity"
                                                             To="0.8" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="BeamTransform" Storyboard.TargetProperty="X"
                                                             From="-120" To="450" Duration="0:0:2.5"
                                                             RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Beam" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Cyber Danger Button (Red Glow for Force Delete & Override Operations) -->
