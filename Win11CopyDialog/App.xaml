                                <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                <Setter TargetName="ThumbVisual" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{DynamicResource GlowAccentColor}" Opacity="0.85"/>
                                    </Setter.Value>
