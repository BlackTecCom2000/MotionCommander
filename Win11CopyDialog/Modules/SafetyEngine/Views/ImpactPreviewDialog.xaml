<Window x:Class="Win11CopyDialog.Modules.SafetyEngine.Views.ImpactPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предварительный просмотр последствий — Motion Commander"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Шапка -->
                <RowDefinition Height="*"/>    <!-- Список последствий и оценка -->
                <RowDefinition Height="Auto"/> <!-- Подвал -->
            </Grid.RowDefinitions>

            <!-- Шапка с бейджем риска -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Border x:Name="RiskBadge" DockPanel.Dock="Right" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="RiskBadgeText" Text="Безопасно" FontSize="11" FontWeight="Bold" Foreground="White"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ImpactTitle" Text="Предварительный просмотр последствий" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="TargetSummaryText" Text="Анализ выбранных объектов..." FontSize="11.5" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Тело диалога -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Предупреждение о системных файлах (если есть) -->
                    <Border x:Name="SystemWarningCard" Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="SystemWarningText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Обратимость действия -->
                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🔄 Статус обратимости:" FontSize="10" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="ReversibilityText" Text="" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Точный список последствий -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📋 Точный список последствий операции:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ImpactDetailsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Резервный план / откат -->
                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="🛡 План безопасности и отката:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="EmergencyPlanText" Text="" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Подвал с кнопками -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource CyberToolButton}" Content="Отмена" Padding="16,7" Click="Cancel_Click"/>
                <Button x:Name="ConfirmBtn" DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="✓ Подтвердить и продолжить" Padding="20,7" FontWeight="Bold" Click="Confirm_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
