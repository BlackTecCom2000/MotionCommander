<Window x:Class="Win11CopyDialog.Modules.Navigation.Views.GlobalSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Глобальный поиск и палитра команд — Motion Commander"
        Width="640" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Поле ввода поиска -->
                <RowDefinition Height="*"/>    <!-- Список результатов -->
                <RowDefinition Height="Auto"/> <!-- Подвал со справкой по клавишам -->
            </Grid.RowDefinitions>

            <!-- Поле ввода поиска -->
            <Border Grid.Row="0" Background="{DynamicResource ChipBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchInput" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalContentAlignment="Center" TextChanged="SearchInput_TextChanged" PreviewKeyDown="SearchInput_PreviewKeyDown"/>
                </DockPanel>
            </Border>

            <!-- Список результатов -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent" SelectionChanged="ResultsList_SelectionChanged" MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,8" Margin="0,2,0,2">
                                <DockPanel>
                                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource ChipBackgroundBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- Подвал со справкой -->
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="↑ / ↓" FontSize="9.5" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Навигация" FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="Enter" FontSize="9.5" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Выбрать" FontSize="10" Style="{StaticResource MutedText}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <Border Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="Esc" FontSize="9.5" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Закрыть" FontSize="10" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Ctrl + K" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
