<Window x:Class="Win11CopyDialog.Modules.OperationsQueue.Views.OperationsQueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Win11CopyDialog.Modules.OperationsQueue.Views"
        Title="Единая очередь операций — Motion Commander"
        Width="780" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Шапка -->
                <RowDefinition Height="Auto"/> <!-- Вкладки -->
                <RowDefinition Height="*"/>    <!-- Список операций -->
                <RowDefinition Height="Auto"/> <!-- Подвал -->
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource CyberToolButton}" Content="✕" Width="32" Height="32" Click="Close_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <DockPanel>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="QUEUE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Единая очередь операций" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </DockPanel>
                    <TextBlock Text="Централизованный мониторинг и управление копированием, загрузками, архивацией и сканированием" FontSize="11" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Переключатель вкладок -->
            <Border Grid.Row="1" Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="10" Padding="4" Margin="0,0,0,14" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabActiveRadio" Content="⚡ Активные и в очереди" Style="{StaticResource StorageSubTab}" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabHistoryRadio" Content="📜 История операций" Style="{StaticResource StorageSubTab}" Margin="6,0,0,0" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <!-- Контент: Активные операции -->
            <Grid x:Name="ViewActive" Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="ActiveEmptyPlaceholder" Text="В данный момент нет активных операций. Все задачи завершены." FontSize="12" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="ActiveItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Иконка типа -->
                                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource ChipBackgroundBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Заголовок и описание -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Кнопки управления -->
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource CyberToolButton}" Content="⏸ Пауза" Margin="0,0,6,0" Padding="8,4" Tag="{Binding Id}" Click="Pause_Click" Visibility="{Binding CanPause, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Style="{StaticResource CyberButton}" Content="▶ Возобновить" Margin="0,0,6,0" Padding="8,4" Tag="{Binding Id}" Click="Resume_Click" Visibility="{Binding CanResume, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Style="{StaticResource CyberToolButton}" Content="✕ Отмена" Padding="8,4" Tag="{Binding Id}" Click="Cancel_Click" Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Прогресс и телеметрия -->
                                            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="6" BorderThickness="0" Background="{DynamicResource ChipBackgroundBrush}" Foreground="{DynamicResource AccentBrush}"/>
                                                <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding SpeedText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding EtaText}" FontSize="10" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding ProgressInt, StringFormat='{}{0}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Контент: История операций -->
            <Grid x:Name="ViewHistory" Grid.Row="2" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="HistoryEmptyPlaceholder" Text="История операций пуста." FontSize="12" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="HistoryItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ChipBackgroundBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Border CornerRadius="6" Padding="8,3" Background="{DynamicResource ChipBackgroundBrush}" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <Button Style="{StaticResource CyberButton}" Content="↺ Повторить" Margin="0,6,0,0" Padding="8,4" Tag="{Binding Id}" Click="Retry_Click" Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="10" Foreground="#EF4444" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Подвал -->
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource CyberToolButton}" Content="🗑 Очистить историю" Padding="12,6" Click="ClearHistory_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource CyberButton}" Content="Закрыть" Padding="16,6" Click="Close_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
